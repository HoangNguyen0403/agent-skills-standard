{
  "schema": "offline-proof-policy-v1",
  "operator_execution": "DENY",
  "vendor_execution": "DENY",
  "allowed_guest_programs": ["/usr/bin/python3.13 -I -S -B /opt/offline-proof/bootstrap.py", "manifest-only"],
  "forbidden_guest_inputs": ["TRUST_ROOT", "CODEX_HOME", "real account state", "host HOME", "host checkout outside exact closure"],
  "vm": {
    "vcpus": 2,
    "memory_mib": 4096,
    "network": false,
    "host_shares": false,
    "vsock": false,
    "rosetta": false,
    "gpu": false,
    "read_only_input": "usb-mass-storage",
    "writable_filesystems": 1,
    "writable_filesystem_bytes": 4294967296,
    "pids_max": 3,
    "target_control_fd": false
  },
  "limits": {
    "preparation": {"starts": 1, "seconds": 900},
    "harmless_fixture": {"starts": 8, "seconds": 300},
    "inspection": {"starts": 2, "seconds": 300},
    "automatic_retry": false,
    "stdout_bytes": 16777216,
    "stderr_bytes": 16777216,
    "trusted_records_bytes": 67108864,
    "campaign_logical_bytes": 68719476736
  },
  "fixtures": [
    {"id": "H1-positive-isolation", "purpose": "positive self-check inside isolated namespace"},
    {"id": "H2-aggregate-storage", "purpose": "storage accounting and protected output layout"},
    {"id": "H3-stdout-overflow", "purpose": "bounded stdout prefix and durable overflow stop"},
    {"id": "H4-stderr-overflow", "purpose": "bounded stderr prefix and durable overflow stop"},
    {"id": "H5-deadline", "purpose": "host watchdog deadline including startup"},
    {"id": "H6-host-interruption", "purpose": "owned positive-PID interruption and reap evidence"},
    {"id": "H7-guest-transport-failure", "purpose": "truthful failure and complete bounded evidence retention"},
    {"id": "H8-one-shot-replay", "purpose": "atomic claim, no retry, and replay refusal"}
  ],
  "inspection_runs": ["I1-read-only-integrity", "I2-replay-free-evidence"],
  "seccomp": {
    "default_action": "ALLOW",
    "clone3_action": "ERRNO(ENOSYS)",
    "clone_policy": "permit only fixed reviewed pthread flag mask; deny process-form clone, every unsupported/unknown bit, and namespace/process flags",
    "denied_syscalls": [
      "execve", "execveat", "fork", "vfork", "ptrace", "process_vm_readv", "process_vm_writev",
      "unshare", "setns", "mount", "umount2", "pivot_root", "chroot", "open_by_handle_at",
      "socket", "socketpair", "connect", "bind", "listen", "accept", "accept4",
      "kill", "tkill", "tgkill", "pidfd_send_signal", "rt_sigqueueinfo", "rt_tgsigqueueinfo",
      "setitimer", "timer_create", "timer_settime", "timer_gettime", "timer_getoverrun", "timer_delete",
      "bpf", "perf_event_open", "userfaultfd", "io_uring_setup", "io_uring_enter", "io_uring_register",
      "keyctl", "add_key", "request_key", "kexec_load", "kexec_file_load", "init_module", "finit_module", "delete_module",
      "reboot", "swapon", "swapoff", "acct", "prctl", "seccomp", "setuid", "setgid", "setreuid", "setregid", "setresuid", "setresgid"
    ],
    "fail_closed_if_syscall_unresolved": true
  },
  "storage_layout": ["sealed-input.img", "runtime.img", "runs/<run-id>/writable.img", "runs/<run-id>/evidence/", "ledger/"],
  "external_mapping": {"reserved": true, "exercised": false}
}

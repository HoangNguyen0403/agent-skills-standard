  quality-engineering:
    ref: quality-engineering-v1.6.2
  system-design:
    ref: system-design-v1.2.5
  cybersecurity:
    ref: cybersecurity-v1.0.2
custom_overrides: []
workflows:
  - sdlc
  - brainstorm-feature
  - code-review
  - codebase-review
  - system-design-session
  - review-system-design
  - design-solution
  - implementation-readiness
  - plan-feature
  - skill-benchmark
  - evals-run
  - pentest
  - dev-fix
  - implement-feature
  - verify-work
  - verify-bug
  - security-test
  - test-loop
  - uat-signoff
  - deploy-release
  - monitor-respond
  - incident-hotfix
  - traceability-audit
  - session-report
  - publish-notes
  - retro-learn
  - battle-test
  - update-docs
  - zephyr-coverage-analysis
  - cyber-exercise
  - cyber-triage
  - cyber-purple-validation
workflows_ref: workflows-v2.1.1
specialists_ref: specialists-v1.5.2
mcp:
  enabled: true
  scope: project
  prompted: true

registry: https://github.com/HoangNguyen0403/agent-skills-standard
agents:
  - copilot
  - antigravity
  - codex
  - claude
skills:
  typescript:
    ref: typescript-v1.3.4
  common:
    ref: common-v2.5.0
    exclude:
      - common-accessibility
      - common-api-design
      - common-architecture-audit
      - common-error-handling
      - common-mobile-animation
      - common-mobile-ux-core
      - common-observability
  quality-engineering:
    ref: quality-engineering-v1.5.1
  system-design:
    ref: system-design-v2.0.0
custom_overrides: []
workflows:
  - sdlc
  - brainstorm-feature
  - code-review
  - codebase-review
  - system-design-session
  - review-system-design
  - design-solution
  - implementation-readiness
  - plan-feature
  - review-ticket
  - skill-benchmark
  - evals-run
  - pentest
  - dev-fix
  - implement-feature
  - verify-work
  - verify-bug
  - security-test
  - test-loop
  - uat-signoff
  - deploy-release
mcp:
  enabled: true
  scope: project
  prompted: true

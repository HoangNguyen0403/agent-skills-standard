{
  "name": "agent-skills-standard-root",
  "version": "2.6.1",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "lodash": "npm:lodash-es@^4.17.21",
      "path-to-regexp": ">=8.4.2",
      "ip-address": "10.3.1",
      "hono": "4.12.34",
      "fast-uri": "3.1.5",
      "picomatch": ">=4.0.4",
      "serialize-javascript": ">=7.0.5",
      "qs": ">=6.15.2",
      "js-yaml": "4.3.1",
      "multer": ">=2.2.0",
      "vite": "7.3.6",
      "postcss": "8.5.23",
      "@modelcontextprotocol/sdk>ajv": "8.18.0",
      "@angular-devkit/core>ajv": "8.18.0",
      "minimatch@3>brace-expansion": "1.1.18",
      "minimatch@9>brace-expansion": "2.1.4",
      "minimatch@10>brace-expansion": "5.0.9",
      "@hono/node-server": "1.19.15",
      "express@4>body-parser": "1.20.6",
      "express@5>body-parser": "2.3.0",
      "form-data": "4.0.6",
      "@babel/core": "7.29.6"
    }
  },
  "scripts": {
    "build": "pnpm --filter ./cli build",
    "dev": "pnpm --filter ./cli dev",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "lint:check": "pnpm -r lint:check",
    "validate": "pnpm --filter ./cli validate",
    "validate:all": "pnpm --filter ./cli validate:all && pnpm audit:skills && pnpm audit:injection",
    "test": "pnpm --filter ./cli test && pnpm test:evals",
    "test:evals": "node --import tsx --test scripts/evals/*.test.ts",
    "test:cov": "pnpm --filter ./cli test:cov",
    "release-all-skills": "tsx scripts/release-all-skills.ts",
    "verify:release-tags": "tsx scripts/verify-release-tags.ts",
    "release-cli": "tsx scripts/release-cli.ts",
    "server:release": "tsx scripts/release-server.ts",
    "mcp:release": "tsx scripts/release-mcp.ts",
    "server:dev": "pnpm --filter ./server start:dev",
    "server:build": "pnpm --filter ./server build",
    "server:start": "pnpm --filter ./server start:prod",
    "mcp:dev": "pnpm --filter ./mcp dev",
    "mcp:build": "pnpm --filter ./mcp build",
    "mcp:start": "pnpm --filter ./mcp start",
    "mcp:test": "pnpm --filter ./mcp test",
    "calculate-tokens": "tsx scripts/calculate-tokens.ts",
    "benchmark": "tsx scripts/benchmark/index.ts",
    "benchmark:report": "tsx scripts/benchmark/index.ts --report-only",
    "evals:manifest": "tsx scripts/evals/index.ts manifest",
    "evals:manifest:all": "tsx scripts/evals/index.ts manifest --all",
    "evals:baseline": "tsx scripts/evals/index.ts baseline",
    "evals:promote": "tsx scripts/evals/index.ts promote",
    "evals:score": "tsx scripts/evals/index.ts score",
    "evals:report": "tsx scripts/evals/index.ts report",
    "evals:verify": "tsx scripts/evals/index.ts verify",
    "evals:compose": "tsx scripts/evals/index.ts compose",
    "evals:prune": "tsx scripts/evals/index.ts prune",
    "evals:audit": "tsx scripts/evals/quality.ts audit",
    "evals:preflight": "tsx scripts/evals/quality.ts preflight",
    "evals:queue": "tsx scripts/evals/quality.ts queue",
    "evals:standardize": "tsx scripts/evals/quality.ts audit --write",
    "generate-indices": "tsx scripts/generate-indices.ts",
    "audit:skills": "tsx scripts/audit-skills.ts",
    "audit:keywords": "tsx scripts/check-keyword-collisions.ts",
    "migrate:priority-labels": "tsx scripts/migrate-priority-labels.ts",
    "audit:sdlc": "node --import tsx ./scripts/audit-sdlc.ts",
    "check-alignment": "tsx scripts/check-alignment.ts",
    "check-alignment:strict": "tsx scripts/check-alignment.ts --threshold 90",
    "audit:injection": "tsx scripts/scan-injection.ts",
    "docs:scan": "tsx scripts/scan-docs.ts scripts server/src",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.30",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.4.0",
    "globals": "^17.11.0",
    "gpt-tokenizer": "^3.4.0",
    "husky": "^9.1.7",
    "inquirer": "^9.3.7",
    "js-yaml": "^4.2.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}

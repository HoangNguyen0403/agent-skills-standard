                "type": "regex",
                "value": "(?:unresolved|unverified|not (?:executed|run)|did not (?:execute|run)|blocked)"
              },
              {
                "type": "not_contains",
                "value": "agent-qa 0.2.3 run"
              }
            ]
          },
          {

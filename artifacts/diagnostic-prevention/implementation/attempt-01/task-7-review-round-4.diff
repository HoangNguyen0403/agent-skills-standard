+/** Build the refusal for any existing output leaf without following symlinks. */
+function outputConflict(outPath, entry, suffix = '') {
+  const type = entry.isSymbolicLink() ? 'symlink' : entry.isDirectory() ? 'directory' : 'file';
+  return new Error(`Output target already exists at ${outPath} (type: ${type})${suffix}. Refusing to overwrite existing sealed output. Use a fresh output path.`);
+}
+
+/**
+ * Release only the claim this invocation wrote and report the outcome.
+ * Returns null on success, otherwise a description the caller must surface.
+ */
+function releaseOwnedClaim(claimPath, claimRecord) {
+  let current;
+  try {
+    current = fs.readFileSync(claimPath, 'utf8');
+  } catch (error) {
+    return `cannot read the owned claim to confirm ownership (${error.message}); leaving it untouched`;
+  }
+  if (current !== claimRecord) {
+    return 'claim bytes no longer match this invocation; leaving the existing claim untouched';
+  }
+  try {
+    fs.unlinkSync(claimPath);
+  } catch (error) {
+    return `unlink failed (${error.message})`;
+  }
+  return null;
+}
+
+/**
+ * Refuse an existing output leaf, take an exclusive claim, then re-check the leaf
+ * because a cooperating run can publish its seal between those two steps.
+ * `beforeClaim` is an ordering seam used only by the competing-run regression.
+ */
+export function preflightExclusiveOutput(outPath, options = {}) {
+  const earlyLstat = fs.lstatSync(outPath, { throwIfNoEntry: false });
+  if (earlyLstat) throw outputConflict(outPath, earlyLstat);
+  if (typeof options.beforeClaim === 'function') options.beforeClaim();
+  const claimPath = `${outPath}.claim`;
+  const claimRecord = JSON.stringify({ pid: process.pid, startedAt: new Date().toISOString() });
+  try {
+    fs.mkdirSync(path.dirname(claimPath), { recursive: true });
+    fs.writeFileSync(claimPath, claimRecord, { flag: 'wx' });
+  } catch (claimErr) {
+    throw new Error(`Failed to acquire exclusive output claim at ${claimPath}: ${claimErr.message}. Another run may be in progress or target directory unwritable.`);
+  }
+  let released = false;
+  try {
+    const claimedLstat = (options.lstatSync ?? fs.lstatSync)(outPath, { throwIfNoEntry: false });
+    if (claimedLstat) {
+      const conflict = outputConflict(outPath, claimedLstat, ' after acquiring the exclusive claim');
+      const releaseError = releaseOwnedClaim(claimPath, claimRecord);
+      released = true;
+      if (releaseError) conflict.message = `${conflict.message}; additionally failed to release ${claimPath}: ${releaseError}`;
+      throw conflict;
+    }
+  } catch (error) {
+    if (!released) {
+      const releaseError = releaseOwnedClaim(claimPath, claimRecord);
+      if (releaseError) error.message = `${error.message}; additionally failed to release ${claimPath}: ${releaseError}`;
+    }
+    throw error;
+  }
+  return { claimPath, claimRecord, release: () => releaseOwnedClaim(claimPath, claimRecord) };
+}
+
+/** Keep the exclusive claim alive for the whole attempt, including receipt failures. */
+export async function runWithOwnedClaim(outPath, task, options = {}) {
+  const claim = preflightExclusiveOutput(outPath, options);
+  let taskError = null;
+  let releaseError = null;
+  let result;
+  try {
+    result = await task(claim);
+  } catch (error) {
+    taskError = error;
+  } finally {
+    releaseError = claim.release();
+  }
+  if (taskError) {
+    if (releaseError) taskError.message = `${taskError.message}; additionally failed to release ${claim.claimPath}: ${releaseError}`;
+    throw taskError;
+  }
+  if (releaseError) {
+    throw new Error(`Failed to release the exclusive output claim at ${claim.claimPath}: ${releaseError}`);
+  }
+  return result;
+}

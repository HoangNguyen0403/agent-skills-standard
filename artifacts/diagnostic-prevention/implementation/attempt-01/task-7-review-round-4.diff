+      if (callback) process.nextTick(callback, Object.assign(new Error('Server is not running'), { code: 'ERR_SERVER_NOT_RUNNING' }));
+      return owned;
+    }
+    if (callback) process.nextTick(callback, new Error('late close failure'));
+    return owned;
+  };
+  let lateFailure = null;
+  let outcome;
+  try {
+    fs.mkdirSync(path.join(candidateRoot, 'skills'), { recursive: true });
+    fs.writeFileSync(path.join(candidateRoot, 'skills/metadata.json'), JSON.stringify({ categories: {} }));
+    const error = await startRegistryFixture(candidateRoot, {
+      server: owned,
+      commitSha: '1111222233334444555566667777888899990000',
+      timeoutMs: 20,
+      onCleanupFailure: (failure) => {
+        lateFailure = failure;
+      },
+      bindHook: (srv) => {
+        setTimeout(() => srv.listen(0, '127.0.0.1'), 40);
+      },
+    }).then(() => {
+      throw new Error('expected the bounded deadline to reject');
+    }, (rejection) => rejection);
+
+    assert.match(error.message, /listen timed out after 20ms/);
+    outcome = await error.cleanup;
+    await waitUntil(() => lateFailure !== null, 'late cleanup failure');
+    assert.match(lateFailure.message, /late close failure/);
+    assert.equal(outcome.lateFailures.length, 1);
+    assert.equal(owned.listening, true);
+    assert.ok(owned.address());
+    assert.equal(outcome.closed, false);
+    assert.match(outcome.error.message, /late close failure/);
+    assert.doesNotThrow(() => owned.emit('error', new Error('owned late error')));
+  } finally {
+    await new Promise((resolve) => realClose(() => resolve()));
+    fs.rmSync(candidateRoot, { recursive: true, force: true });
+  }
+  assert.equal(outcome.closed, true);
+  assert.equal(outcome.error, null);
+});

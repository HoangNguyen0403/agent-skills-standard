+  type ManifestEntry,
+  type SkillsLockFile,
+} from '../../cli/src/services/LockfileService';
+import { assertNoSymlinksUnderRoot } from '../../cli/src/services/install/safePath';
+import { isOverriddenRel } from '../../cli/src/services/install/pathMatch';
+import {
+  Agent,

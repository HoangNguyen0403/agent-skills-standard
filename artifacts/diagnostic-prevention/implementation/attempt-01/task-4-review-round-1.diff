 ## Secret Management (Python)
 
 ```python
 # Secret management — never hardcode credentials
 import os
 API_KEY = os.environ["API_KEY"]  # Good: from environment
 # API_KEY = "sk-abc123"          # Bad: hardcoded secret
 ```
+
+## Operation-Private Minting & Transaction-Time Revalidation
+
+```typescript
+// Mint credentials scoped strictly to single operation
+async function executePrivilegedTransfer(
+  operationId: string,
+  actorId: string,
+  transferPayload: TransferDto
+): Promise<Receipt> {
+  // Re-validate authority at transaction time against primary store
+  const authority = await authService.revalidateAuthority(actorId, {
+    action: 'transfer',
+    resource: transferPayload.sourceAccount,
+  });
+  if (!authority.isValid) {
+    throw new UnauthorizedException('Authority stale or invalid');
+  }
+
+  // Operation-private credential: tied to operationId, single use, short TTL
+  const opProof = await cryptoService.mintOperationToken({
+    operationId,
+    actorId,
+    scope: 'transfer:execute',
+    expiresInSeconds: 30,
+  });
+
+  // Atomic execution guarding against second-process / multi-connection race
+  return db.transaction(async (tx) => {
+    return tx.executeTransfer(transferPayload, opProof);
+  });
+}
+```
+
+## Authenticated Persisted Evidence
+
+```typescript
+// Persist audit records with cryptographic signature and caller provenance
+interface PersistedAuditEvent {
+  eventId: string;
+  operationId: string;
+  callerPrincipal: string;
+  action: string;
+  timestamp: string;
+  signature: string; // HMAC or Ed25519 signature over serialized event
+}
+
+async function recordAuditEvent(event: Omit<PersistedAuditEvent, 'signature'>): Promise<void> {
+  const signature = cryptoService.sign(JSON.stringify(event), getSigningKey());
+  await db.query(
+    'INSERT INTO audit_events (event_id, operation_id, caller_principal, action, timestamp, signature) VALUES ($1, $2, $3, $4, $5, $6)',
+    [event.eventId, event.operationId, event.callerPrincipal, event.action, event.timestamp, signature]
+  );
+}
+```

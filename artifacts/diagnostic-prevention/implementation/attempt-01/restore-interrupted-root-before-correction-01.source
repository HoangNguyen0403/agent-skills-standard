  },
  {
    id: 'effect-audit',
    rel: `${A_REL}/root-interrupted-effect-audit-01.json`,
    sha256:
      '6294f5b5c8afbd4ef680d6f2a8e94b57f14df8948cc55035dbd6afd4f780d7e5',
  },
  {
    id: 'publication-before-proof',
    rel: `${ATTEMPT_REL}/publication-before/proof.json`,
    sha256:
      '7918b85b217d839827d0609f5a8f869b5ea3388185d9af159f76d1e70d82679b',
  },
  {
    id: 'adoption-proof',
    rel: `${ATTEMPT_REL}/adoption/proof.json`,
    sha256:
      'af0cf808a312c8b791664800e0a26ade86df36664d110a16a5f6b9df05123690',
  },
  {

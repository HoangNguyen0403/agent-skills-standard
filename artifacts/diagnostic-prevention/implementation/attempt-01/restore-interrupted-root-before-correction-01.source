const ATTEMPT_REL = 'artifacts/generation-logs/attempt-2026-10-29T07-41-49-505Z-fd751a';
const CLAIM_NAME = '.restore-interrupted-root.claim';
const QUARANTINE_NAME = 'root-interrupted-temp-quarantine-01';
const LEDGER_REL = '.skills-lock.json';
const CONFIG_PATHS = ['.skillsrc', '.skillsrc.yaml'];
const REGULAR_MODES = new Set(['100644', '100755']);
const MAX_SMALL_FILE_BYTES = 8 * 1024 * 1024;
const GIT_MAX_BUFFER = 128 * 1024 * 1024;

const PINS = [
  {
    id: 'core-helper',
    rel: 'scripts/generation/isolated-stage.ts',
    sha256:

];

const TEMP = {
  rel: '.agents/skills/common/common-subagent-driven-development/references/.ags-tmp-Ati9K9',
  device: 16777231,
  directoryInode: 345126518,
  directoryMode: 0o700,
  payloadName: 'payload',
  payloadInode: 345126519,
  payloadMode: 0o644,
  payloadSha256:
    '0e1bad24d9b189a6007aa9905aea9f3ed327d4d98d180594ffd0be219c430a22',
};

const USAGE = `Usage: node ${A_REL}/restore-interrupted-root.mjs --out <fresh-evidence-dir> [--apply]

Dry-run is the default and only hashes root data; it never mutates a recovery target or the
retained temporary. --apply performs the single audited transaction: restore the 15
PUBLISHED_CANDIDATE destinations from the pinned publication-before bytes, then move the
pinned interrupted temporary directory into ${QUARANTINE_NAME}.

--out must resolve beneath ${A_REL}/ and must not already exist.
Supported flags: --out <dir>, --apply, --help.
Exit codes: 0 dry-run/apply verified, 1 refused or failed, 2 usage.
`;

/** Refusal carrying a fixed machine code; detail is evidence-only text. */
class Refusal extends Error {
  constructor(code, detail = null) {
    super(detail ? `${code}: ${detail}` : code);
    this.name = 'Refusal';
    this.code = code;
    this.detail = detail;
  }
}

function refuse(code, detail = null) {
  throw new Refusal(code, detail);
}

function hashBytes(value) {
  return createHash('sha256').update(value).digest('hex');
}

function modeOctal(mode) {
  return (mode & 0o777).toString(8).padStart(4, '0');
}

function toPosix(relativePath) {
  return relativePath.split(path.sep).join('/');
}

async function lstatOrNull(absolutePath) {
  try {
    return await fs.lstat(absolutePath);
  } catch (error) {
    if (error.code === 'ENOENT') return null;
    throw error;
  }
}

async function digestFile(absolutePath, maxBytes = MAX_SMALL_FILE_BYTES) {
  const stat = await lstatOrNull(absolutePath);
  if (!stat) return { ok: false, code: 'MISSING' };
  if (stat.isSymbolicLink()) return { ok: false, code: 'SYMLINK' };
  if (!stat.isFile()) return { ok: false, code: 'NOT_REGULAR' };
  if (stat.size > maxBytes) return { ok: false, code: 'TOO_LARGE' };
  const bytes = await fs.readFile(absolutePath);
  return {
    ok: true,
    bytes,
    sha256: hashBytes(bytes),
    size: stat.size,
    mode: stat.mode & 0o777,
  };
}

function assertSafeRelative(relativePath) {
  if (typeof relativePath !== 'string' || relativePath.length === 0) {
    refuse('UNSAFE_RELATIVE_PATH', 'empty');
  }
  if (relativePath.includes('\0')) refuse('UNSAFE_RELATIVE_PATH', relativePath);
  if (path.posix.isAbsolute(relativePath)) {
    refuse('UNSAFE_RELATIVE_PATH', relativePath);
  }
  if (path.posix.normalize(relativePath) !== relativePath) {
    refuse('UNSAFE_RELATIVE_PATH', relativePath);
  }
  for (const segment of relativePath.split('/')) {
    if (segment === '' || segment === '.' || segment === '..') {
      refuse('UNSAFE_RELATIVE_PATH', relativePath);
    }
  }
}

const verifiedDirectoryCache = new Set();

/**
 * Verifies every ancestor directory of `relativePath` is a real directory, never a symlink.
 * Callers performing effects pass `useCache: false` so topology is re-read immediately
 * before a replacement rather than trusted from an earlier phase.
 */
async function assertAncestorDirs(rootAbs, relativePath, useCache = true) {
  assertSafeRelative(relativePath);
  const segments = relativePath.split('/');
  let current = '';
  for (let index = 0; index < segments.length - 1; index += 1) {
    current = current === '' ? segments[index] : `${current}/${segments[index]}`;
    if (useCache && verifiedDirectoryCache.has(current)) continue;
    const stat = await lstatOrNull(path.join(rootAbs, current));
    if (!stat) refuse('ANCESTOR_MISSING', current);
    if (stat.isSymbolicLink()) refuse('ANCESTOR_SYMLINK', current);
    if (!stat.isDirectory()) refuse('ANCESTOR_NOT_DIRECTORY', current);
    if (useCache) verifiedDirectoryCache.add(current);
  }
}

function runGit(args) {
  try {
    const stdout = execFileSync('git', args, {
      cwd: WORKSPACE,
      maxBuffer: GIT_MAX_BUFFER,
      stdio: ['ignore', 'pipe', 'pipe'],
    });
    return { ok: true, stdout };
  } catch (error) {
    return {
      ok: false,
      status: typeof error.status === 'number' ? error.status : null,
      stderr: Buffer.isBuffer(error.stderr)
        ? error.stderr.toString('utf8').slice(0, 4000)
        : '',
    };
  }
}

function splitNulRecords(buffer) {
  const text = buffer.toString('utf8');
  if (text.length === 0) return [];
  const records = text.split('\0');
  if (records[records.length - 1] === '') records.pop();
  return records;
}

function parseIndexListing(buffer) {
  const map = new Map();
  for (const record of splitNulRecords(buffer)) {
    const tab = record.indexOf('\t');
    if (tab === -1) refuse('INDEX_RECORD_MALFORMED');
    const meta = record.slice(0, tab).split(' ');
    if (meta.length !== 3) refuse('INDEX_RECORD_MALFORMED');
    const [mode, objectId, stage] = meta;
    const relPath = record.slice(tab + 1);
    const existing = map.get(relPath) ?? [];
    existing.push({ mode, objectId, stage });
    map.set(relPath, existing);
  }
  return map;
}

function parseTreeListing(buffer) {
  const map = new Map();
  for (const record of splitNulRecords(buffer)) {
    const tab = record.indexOf('\t');
    if (tab === -1) refuse('TREE_RECORD_MALFORMED');
    const meta = record.slice(0, tab).split(' ');
    if (meta.length !== 3) refuse('TREE_RECORD_MALFORMED');
    const [mode, type, objectId] = meta;
    const relPath = record.slice(tab + 1);
    const existing = map.get(relPath) ?? [];
    existing.push({ mode, type, objectId });
    map.set(relPath, existing);
  }
  return map;
}

function indexIdentityOf(listingBuffer, head) {
  return hashBytes(
    Buffer.from(`${head}\n${hashBytes(listingBuffer)}\n`, 'utf8'),
  );
}

function pinById(id) {
  const pin = PINS.find((candidate) => candidate.id === id);
  if (!pin) refuse('PIN_DEFINITION_MISSING', id);
  return pin;
}

function parseArgs(argv) {
  const parsed = { apply: false, out: null, help: false };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--help') {
      parsed.help = true;
      continue;
    }
    if (arg === '--apply') {
      if (parsed.apply) throw usageError('DUPLICATE_FLAG');
      parsed.apply = true;
      continue;
    }
    if (arg === '--out') {
      if (parsed.out !== null) throw usageError('DUPLICATE_FLAG');
      const value = argv[index + 1];
      if (value === undefined || value.startsWith('--')) {
        throw usageError('MISSING_OUT_VALUE');
      }
      parsed.out = value;
      index += 1;
      continue;
    }
    throw usageError('UNSUPPORTED_FLAG');
  }
  if (!parsed.help && parsed.out === null) throw usageError('MISSING_OUT');
  return parsed;
}

function usageError(code) {
  const error = new Error(code);
  error.code = code;
  error.usage = true;
  return error;
}

async function assertWorkspace() {
  const physicalWorkspace = await fs.realpath(WORKSPACE);
  const physicalCwd = await fs.realpath(process.cwd());
  if (physicalCwd !== physicalWorkspace) refuse('WORKSPACE_MISMATCH');
  const aStat = await fs.lstat(path.join(physicalWorkspace, A_REL));
  if (aStat.isSymbolicLink() || !aStat.isDirectory()) {
    refuse('ATTEMPT_ARTIFACTS_NOT_DIRECTORY');
  }
}

async function prepareEvidenceDir(outArg) {
  if (typeof outArg !== 'string' || outArg.length === 0) {
    throw usageError('MISSING_OUT');
  }
  const artifactsAbs = path.join(WORKSPACE, A_REL);
  const resolved = path.resolve(WORKSPACE, outArg);
  const relative = path.relative(artifactsAbs, resolved);
  if (
    relative === '' ||
    relative === '..' ||
    relative.startsWith(`..${path.sep}`) ||
    path.isAbsolute(relative)
  ) {
    refuse('OUTSIDE_ATTEMPT_ARTIFACTS', outArg);
  }
  assertSafeRelative(toPosix(relative));
  await assertAncestorDirs(WORKSPACE, toPosix(path.relative(WORKSPACE, resolved)));
  const parentAbs = path.dirname(resolved);
  const parentStat = await lstatOrNull(parentAbs);
  if (!parentStat) refuse('OUTPUT_PARENT_MISSING', outArg);
  if (parentStat.isSymbolicLink() || !parentStat.isDirectory()) {
    refuse('OUTPUT_PARENT_INVALID', outArg);
  }
  try {
    await fs.mkdir(resolved, { mode: 0o700 });
  } catch (error) {
    if (error.code === 'EEXIST') refuse('OUTPUT_ALREADY_EXISTS', outArg);
    throw error;
  }
  const created = await fs.lstat(resolved);
  if (created.isSymbolicLink() || !created.isDirectory()) {
    refuse('OUTPUT_NOT_DIRECTORY', outArg);
  }
  return resolved;
}

async function acquireClaim(mode, outRelative) {
  const claimAbs = path.join(WORKSPACE, A_REL, CLAIM_NAME);
  const record = {
    schemaVersion: 1,
    kind: 'ONE_OFF_RESTORATION_OPERATOR_CLAIM',
    pid: process.pid,
    startedAt: new Date().toISOString(),
    mode,
    out: outRelative,
  };
  const bytes = Buffer.from(`${JSON.stringify(record)}\n`, 'utf8');
  try {
    await fs.writeFile(claimAbs, bytes, { flag: 'wx', mode: 0o600 });
  } catch (error) {
    if (error.code === 'EEXIST') refuse('CLAIM_HELD');
    throw error;
  }
  return { path: claimAbs, bytes };
}

/** Returns null on an ownership-verified release, else a fixed failure code. */
async function releaseClaim(claim) {
  let readBack;
  try {
    readBack = await fs.readFile(claim.path);
  } catch (error) {
    return `CLAIM_READ_FAILED_${error.code ?? 'UNKNOWN'}`;
  }
  if (!readBack.equals(claim.bytes)) return 'CLAIM_OWNERSHIP_MISMATCH';
  try {
    await fs.unlink(claim.path);
  } catch (error) {
    return `CLAIM_UNLINK_FAILED_${error.code ?? 'UNKNOWN'}`;
  }
  return null;
}

class Journal {
  constructor(handle) {
    this.handle = handle;
    this.sequence = 0;
  }

  async record(entry) {
    this.sequence += 1;
    const line = `${JSON.stringify({
      sequence: this.sequence,
      recordedAt: new Date().toISOString(),
      ...entry,
    })}\n`;
    const buffer = Buffer.from(line, 'utf8');
    try {
      let offset = 0;
      while (offset < buffer.length) {
        const { bytesWritten } = await this.handle.write(
          buffer,
          offset,
          buffer.length - offset,
          null,
        );
        if (bytesWritten === 0) refuse('JOURNAL_WRITE_STALLED');
        offset += bytesWritten;
      }
      await this.handle.sync();
    } catch (error) {
      if (error instanceof Refusal) throw error;
      refuse('JOURNAL_WRITE_FAILED', String(error?.code ?? 'UNKNOWN'));
    }
    return this.sequence;
  }

  async close() {
    await this.handle.close();
  }
}

async function readJson(relativePath) {
  const absolutePath = path.join(WORKSPACE, relativePath);
  const info = await digestFile(absolutePath, MAX_SMALL_FILE_BYTES);
  if (!info.ok) refuse('PIN_INPUT_UNREADABLE', `${relativePath}:${info.code}`);
  let value;
  try {
    value = JSON.parse(info.bytes.toString('utf8'));
  } catch {
    refuse('PIN_INPUT_NOT_JSON', relativePath);
  }
  return { info, value };
}

async function verifyPins(state) {
  const observed = [];
  for (const pin of PINS) {
    assertSafeRelative(pin.rel);
    const info = await digestFile(
      path.join(WORKSPACE, pin.rel),
      pin.maxBytes ?? MAX_SMALL_FILE_BYTES,
    );
    if (!info.ok) refuse('PIN_UNREADABLE', `${pin.id}:${info.code}`);
    if (info.sha256 !== pin.sha256) refuse('PIN_HASH_MISMATCH', pin.id);
    if (pin.bytes !== undefined && info.size !== pin.bytes) {
      refuse('PIN_SIZE_MISMATCH', pin.id);
    }
    observed.push({
      id: pin.id,
      relativePath: pin.rel,
      sha256: info.sha256,
      size: info.size,
    });
  }
  state.checks.push({ id: 'pinned-input-identities', observed });
  return observed;
}

function validateProofShape(proof) {
  if (!proof || typeof proof !== 'object') refuse('PROOF_SHAPE');
  if (!Array.isArray(proof.records)) refuse('PROOF_SHAPE');
  if (proof.records.length !== 96) refuse('PROOF_RECORD_COUNT');
  const beforeByPath = new Map();
  for (const record of proof.records) {
    if (!record || typeof record !== 'object') refuse('PROOF_SHAPE');
    assertSafeRelative(record.path);
    if (beforeByPath.has(record.path)) refuse('PROOF_DUPLICATE_PATH', record.path);
    if (record.path === LEDGER_REL) {
      if (record.sha256 !== null) refuse('PROOF_LEDGER_NOT_ABSENT');
      beforeByPath.set(record.path, null);
      continue;
    }
    if (typeof record.sha256 !== 'string' || !/^[0-9a-f]{64}$/.test(record.sha256)) {
      refuse('PROOF_SHAPE', record.path);
    }
    beforeByPath.set(record.path, record.sha256);
  }
  if (beforeByPath.size !== 96) refuse('PROOF_RECORD_COUNT');
  if (beforeByPath.get(LEDGER_REL) !== null) refuse('PROOF_LEDGER_NOT_ABSENT');
  return { beforeByPath };
}

function validateAuditShape(audit, proofSha256, beforeByPath) {
  if (!audit || typeof audit !== 'object') refuse('AUDIT_SHAPE');
  if (!Array.isArray(audit.files)) refuse('AUDIT_SHAPE');
  if (audit.files.length !== 96) refuse('AUDIT_RECORD_COUNT');
  if (audit.publicationBeforeProofSha256 !== proofSha256) {
    refuse('AUDIT_PROOF_LINK_MISMATCH');
  }
  const counts = {
    PUBLISHED_CANDIDATE: 0,
    ORIGINAL_BEFORE: 0,
    LEDGER_UNCHANGED: 0,
  };
  const auditByPath = new Map();
  for (const file of audit.files) {
    if (!file || typeof file !== 'object') refuse('AUDIT_SHAPE');
    assertSafeRelative(file.path);
    if (auditByPath.has(file.path)) refuse('AUDIT_DUPLICATE_PATH', file.path);
    if (file.path === LEDGER_REL) {
      if (file.state !== 'LEDGER_UNCHANGED') refuse('AUDIT_LEDGER_STATE');
      if (file.activeSha256 !== null) refuse('AUDIT_LEDGER_NOT_ABSENT');
      counts.LEDGER_UNCHANGED += 1;
      auditByPath.set(file.path, file);
      continue;
    }
    if (file.state !== 'PUBLISHED_CANDIDATE' && file.state !== 'ORIGINAL_BEFORE') {
      refuse('AUDIT_STATE_UNSUPPORTED', `${file.path}:${file.state}`);
    }
    if (!beforeByPath.has(file.path)) refuse('AUDIT_PATH_NOT_IN_PROOF', file.path);
    if (file.beforeSha256 !== beforeByPath.get(file.path)) {
      refuse('AUDIT_BEFORE_LINK_MISMATCH', file.path);
    }
    if (file.archivedSha256 !== file.beforeSha256) {
      refuse('AUDIT_ARCHIVE_MISMATCH', file.path);
    }
    if (
      typeof file.candidateSha256 !== 'string' ||
      !/^[0-9a-f]{64}$/.test(file.candidateSha256)
    ) {
      refuse('AUDIT_CANDIDATE_MISSING', file.path);
    }
    counts[file.state] += 1;
    auditByPath.set(file.path, file);
  }
  if (auditByPath.size !== beforeByPath.size) refuse('AUDIT_PROOF_PATH_SET');
  for (const relPath of beforeByPath.keys()) {
    if (!auditByPath.has(relPath)) refuse('AUDIT_PROOF_PATH_SET', relPath);
  }
  if (counts.PUBLISHED_CANDIDATE !== 15) refuse('AUDIT_CANDIDATE_COUNT');
  if (counts.ORIGINAL_BEFORE !== 80) refuse('AUDIT_BEFORE_COUNT');
  if (counts.LEDGER_UNCHANGED !== 1) refuse('AUDIT_LEDGER_COUNT');
  return { auditByPath, counts };
}

async function verifyArchiveMetadata(state) {
  const candidates = await readJson(
    `${A_REL}/root-interrupted-candidates-01.json`,
  );
  const candidatePin = pinById('candidate-archive');
  if (candidates.value.sha256 !== candidatePin.sha256) {
    refuse('CANDIDATE_ARCHIVE_LINK_MISMATCH');
  }
  if (candidates.value.files !== 96) refuse('CANDIDATE_ARCHIVE_FILE_COUNT');
  if (candidates.value.effectAudit !== 'root-interrupted-effect-audit-01.json') {
    refuse('CANDIDATE_ARCHIVE_AUDIT_LINK');
  }

  const sourcePin = pinById('source-archive');
  const source = await readJson(`${A_REL}/root-interrupted-source-01.json`);
  if (source.value.sha256 !== sourcePin.sha256) {
    refuse('SOURCE_ARCHIVE_LINK_MISMATCH');
  }
  if (source.value.bytes !== sourcePin.bytes) refuse('SOURCE_ARCHIVE_BYTES');
  if (source.value.baseCommit !== BASE) refuse('SOURCE_ARCHIVE_BASE');

  state.checks.push({
    id: 'archive-metadata-links',
    observed: {
      candidateArchiveSha256: candidates.value.sha256,
      candidateArchiveFiles: candidates.value.files,
      stagedLockRecorded: true,
      stagedLockUsedAsAuthority: false,
      sourceArchiveSha256: source.value.sha256,
      sourceArchiveBytes: source.value.bytes,
    },
  });
}

function runTar(args, maxBuffer = 32 * 1024 * 1024) {
  try {
    const stdout = execFileSync('tar', args, {
      cwd: WORKSPACE,
      maxBuffer,
      stdio: ['ignore', 'pipe', 'pipe'],
    });
    return { ok: true, stdout };
  } catch (error) {
    return {
      ok: false,
      status: typeof error.status === 'number' ? error.status : null,
    };
  }
}

async function verifyCandidateArchive(state, auditByPath) {
  const archiveRel = pinById('candidate-archive').rel;
  const archiveAbs = path.join(WORKSPACE, archiveRel);

  const listing = runTar(['-tf', archiveAbs]);
  if (!listing.ok) refuse('CANDIDATE_ARCHIVE_UNREADABLE');
  const members = listing.stdout
    .toString('utf8')
    .split('\n')
    .filter((entry) => entry.length > 0);
  if (members.length !== 96) refuse('CANDIDATE_ARCHIVE_MEMBER_COUNT');
  const memberByNormalized = new Map();
  for (const member of members) {
    const normalized = member.replace(/^\.\//, '');
    if (memberByNormalized.has(normalized)) {
      refuse('CANDIDATE_ARCHIVE_DUPLICATE_MEMBER', normalized);
    }
    memberByNormalized.set(normalized, member);
  }
  for (const relPath of auditByPath.keys()) {
    if (!memberByNormalized.has(relPath)) {
      refuse('CANDIDATE_ARCHIVE_MEMBER_MISSING', relPath);
    }
  }

  let verifiedCandidates = 0;
  for (const [relPath, file] of auditByPath.entries()) {
    if (relPath === LEDGER_REL) continue;
    const extracted = runTar([
      '-xOf',
      archiveAbs,
      memberByNormalized.get(relPath),
    ]);
    if (!extracted.ok) {
      refuse('CANDIDATE_ARCHIVE_MEMBER_UNREADABLE', relPath);
    }
    if (hashBytes(extracted.stdout) !== file.candidateSha256) {
      refuse('CANDIDATE_ARCHIVE_DIGEST_MISMATCH', relPath);
    }
    verifiedCandidates += 1;
  }
  if (verifiedCandidates !== 95) refuse('CANDIDATE_ARCHIVE_VERIFIED_COUNT');

  state.checks.push({
    id: 'candidate-archive-members',
    observed: {
      members: members.length,
      verifiedCandidateDigests: verifiedCandidates,
      stagedLockBytesRead: false,
    },
  });
}

async function verifyBeforeImages(state, beforeByPath) {
  const inspected = [];
  for (const [relPath, expectedSha256] of beforeByPath.entries()) {
    if (relPath === LEDGER_REL) continue;
    const imageRel = `${ATTEMPT_REL}/publication-before/${relPath}`;
    assertSafeRelative(imageRel);
    await assertAncestorDirs(WORKSPACE, imageRel);
    const info = await digestFile(path.join(WORKSPACE, imageRel));
    if (!info.ok) {
      refuse('BEFORE_IMAGE_UNREADABLE', `${relPath}:${info.code}`);
    }
    if (info.sha256 !== expectedSha256) {
      refuse('BEFORE_IMAGE_HASH_MISMATCH', relPath);
    }
    inspected.push(relPath);
  }
  if (inspected.length !== 95) refuse('BEFORE_IMAGE_COUNT');
  state.checks.push({ id: 'archived-before-images', verified: inspected.length });
}

async function inspectDestinations(state, auditByPath) {
  const restores = [];
  const originalBefore = [];
  const ledgerEntry = auditByPath.get(LEDGER_REL);
  if (!ledgerEntry) refuse('AUDIT_LEDGER_MISSING');

  for (const [relPath, file] of auditByPath.entries()) {
    if (relPath === LEDGER_REL) continue;
    await assertAncestorDirs(WORKSPACE, relPath);
    const absolutePath = path.join(WORKSPACE, relPath);
    const info = await digestFile(absolutePath);
    if (!info.ok) {
      refuse('DESTINATION_UNREADABLE', `${relPath}:${info.code}`);
    }
    if (file.state === 'PUBLISHED_CANDIDATE') {
      if (info.sha256 !== file.candidateSha256) {
        refuse('DESTINATION_CANDIDATE_MISMATCH', relPath);
      }
      restores.push({
        path: relPath,
        beforeSha256: file.beforeSha256,
        candidateSha256: file.candidateSha256,
      });
      continue;
    }
    if (info.sha256 !== file.beforeSha256) {
      refuse('DESTINATION_BEFORE_MISMATCH', relPath);
    }
    originalBefore.push(relPath);
  }

  const ledgerAbs = path.join(WORKSPACE, LEDGER_REL);
  const ledgerStat = await lstatOrNull(ledgerAbs);
  if (ledgerStat) refuse('LEDGER_PRESENT');

  if (restores.length !== 15) refuse('RESTORE_TARGET_COUNT');
  if (originalBefore.length !== 80) refuse('ORIGINAL_BEFORE_COUNT');

  state.checks.push({
    id: 'destination-state',
    observed: {
      publishedCandidate: restores.length,
      originalBefore: originalBefore.length,
      ledgerAbsent: true,
    },
  });
  return { restores, originalBefore };
}

async function captureGitPreflight(restores) {
  const top = runGit(['rev-parse', '--show-toplevel']);
  if (!top.ok) refuse('GIT_UNAVAILABLE');
  const reportedRoot = top.stdout.toString('utf8').trim();
  let physicalReported;
  try {
    physicalReported = await fs.realpath(reportedRoot);
  } catch {
    refuse('GIT_ROOT_UNRESOLVABLE');
  }
  if (physicalReported !== (await fs.realpath(WORKSPACE))) {
    refuse('GIT_ROOT_MISMATCH');
  }

  const headResult = runGit(['rev-parse', '--verify', 'HEAD']);
  if (!headResult.ok) refuse('GIT_HEAD_UNREADABLE');
  const head = headResult.stdout.toString('utf8').trim();
  if (head !== BASE) refuse('HEAD_NOT_PINNED_BASE', head);

  const indexResult = runGit(['ls-files', '--stage', '-z']);
  if (!indexResult.ok) refuse('GIT_INDEX_UNREADABLE');
  const treeResult = runGit(['ls-tree', '-r', '-z', BASE]);
  if (!treeResult.ok) refuse('GIT_TREE_UNREADABLE');

  const indexMap = parseIndexListing(indexResult.stdout);
  const treeMap = parseTreeListing(treeResult.stdout);

  if (indexMap.has(LEDGER_REL)) refuse('LEDGER_TRACKED_IN_INDEX');

  for (const target of restores) {
    const indexEntries = indexMap.get(target.path);
    if (!indexEntries || indexEntries.length !== 1) {
      refuse('TARGET_INDEX_MISSING_OR_AMBIGUOUS', target.path);
    }
    const indexEntry = indexEntries[0];
    if (indexEntry.stage !== '0') refuse('TARGET_INDEX_STAGE', target.path);
    if (!REGULAR_MODES.has(indexEntry.mode)) {
      refuse('TARGET_INDEX_MODE', target.path);
    }
    const treeEntries = treeMap.get(target.path);
    if (!treeEntries || treeEntries.length !== 1) {
      refuse('TARGET_BASE_ENTRY_MISSING', target.path);
    }
    const treeEntry = treeEntries[0];
    if (treeEntry.type !== 'blob' || !REGULAR_MODES.has(treeEntry.mode)) {
      refuse('TARGET_BASE_NOT_REGULAR', target.path);
    }
    if (
      treeEntry.objectId !== indexEntry.objectId ||
      treeEntry.mode !== indexEntry.mode
    ) {
      refuse('TARGET_INDEX_NOT_BASE_IDENTICAL', target.path);
    }
  }

  const indexIdentity = indexIdentityOf(indexResult.stdout, head);
  return {
    head,
    indexMap,
    treeMap,
    indexIdentity,
    indexEntryCount: [...indexMap.values()].reduce(
      (total, entries) => total + entries.length,
      0,
    ),
  };
}

async function captureConfigConditions(state, git) {
  const observations = [];
  for (const relPath of CONFIG_PATHS) {
    assertSafeRelative(relPath);
    const treeEntries = git.treeMap.get(relPath) ?? [];
    const indexEntries = git.indexMap.get(relPath) ?? [];
    if (treeEntries.length > 1 || indexEntries.length > 1) {
      refuse('CONFIG_AMBIGUOUS', relPath);
    }
    const treeEntry = treeEntries[0] ?? null;
    const indexEntry = indexEntries[0] ?? null;
    const live = await digestFile(path.join(WORKSPACE, relPath));

    if (treeEntry) {
      if (treeEntry.type !== 'blob' || !REGULAR_MODES.has(treeEntry.mode)) {
        refuse('CONFIG_BASE_NOT_REGULAR', relPath);
      }
      if (!indexEntry) refuse('CONFIG_INDEX_MISSING', relPath);
      if (
        indexEntry.stage !== '0' ||
        indexEntry.mode !== treeEntry.mode ||
        indexEntry.objectId !== treeEntry.objectId
      ) {
        refuse('CONFIG_INDEX_NOT_BASE_IDENTICAL', relPath);
      }
      if (!live.ok) refuse('CONFIG_MISSING', relPath);
      const blob = runGit(['cat-file', 'blob', treeEntry.objectId]);
      if (!blob.ok) refuse('CONFIG_BASE_BLOB_UNREADABLE', relPath);
      if (hashBytes(blob.stdout) !== live.sha256) {
        refuse('CONFIG_CONDITION_DRIFT', relPath);
      }
      observations.push({
        path: relPath,
        baseTracked: true,
        baseObjectId: treeEntry.objectId,
        sha256: live.sha256,
        mode: modeOctal(live.mode),
      });
      continue;
    }

    if (indexEntry) refuse('CONFIG_INDEX_WITHOUT_BASE', relPath);
    observations.push({
      path: relPath,
      baseTracked: false,
      baseObjectId: null,
      sha256: live.ok ? live.sha256 : null,
      mode: live.ok ? modeOctal(live.mode) : null,
    });
  }
  state.checks.push({ id: 'config-conditions', observed: observations });
  return observations;
}

async function inspectTemp(directoryAbs) {
  const directoryStat = await lstatOrNull(directoryAbs);
  if (!directoryStat) refuse('TEMP_DIRECTORY_MISSING');
  if (directoryStat.isSymbolicLink()) refuse('TEMP_DIRECTORY_SYMLINK');
  if (!directoryStat.isDirectory()) refuse('TEMP_DIRECTORY_NOT_DIRECTORY');
  if ((directoryStat.mode & 0o777) !== TEMP.directoryMode) {
    refuse('TEMP_DIRECTORY_MODE_MISMATCH');
  }
  if (directoryStat.dev !== TEMP.device) refuse('TEMP_DIRECTORY_DEVICE_MISMATCH');
  if (directoryStat.ino !== TEMP.directoryInode) {
    refuse('TEMP_DIRECTORY_INODE_MISMATCH');
  }

  const entries = await fs.readdir(directoryAbs);
  if (entries.length !== 1 || entries[0] !== TEMP.payloadName) {
    refuse('TEMP_DIRECTORY_CONTENTS_MISMATCH');
  }

  const payloadAbs = path.join(directoryAbs, TEMP.payloadName);
  const payloadStat = await lstatOrNull(payloadAbs);
  if (!payloadStat) refuse('TEMP_PAYLOAD_MISSING');
  if (payloadStat.isSymbolicLink()) refuse('TEMP_PAYLOAD_SYMLINK');
  if (!payloadStat.isFile()) refuse('TEMP_PAYLOAD_NOT_REGULAR');
  if ((payloadStat.mode & 0o777) !== TEMP.payloadMode) {
    refuse('TEMP_PAYLOAD_MODE_MISMATCH');
  }
  if (
    payloadStat.dev !== TEMP.device ||
    payloadStat.ino !== TEMP.payloadInode
  ) {
    refuse('TEMP_PAYLOAD_IDENTITY_MISMATCH');
  }
  const payload = await digestFile(payloadAbs, 1024 * 1024);
  if (!payload.ok || payload.sha256 !== TEMP.payloadSha256) {
    refuse('TEMP_PAYLOAD_DIGEST_MISMATCH');
  }

  return {
    directoryMode: modeOctal(directoryStat.mode),
    device: directoryStat.dev,
    directoryInode: directoryStat.ino,
    payloadMode: modeOctal(payloadStat.mode),
    payloadInode: payloadStat.ino,
    payloadSha256: payload.sha256,
  };
}

async function preflight(state) {
  await verifyPins(state);

  const proofPin = pinById('publication-before-proof');
  const proofInput = await readJson(proofPin.rel);
  const { beforeByPath } = validateProofShape(proofInput.value);

  const auditPin = pinById('effect-audit');
  const auditInput = await readJson(auditPin.rel);
  const { auditByPath, counts } = validateAuditShape(
    auditInput.value,
    proofPin.sha256,
    beforeByPath,
  );
  state.checks.push({ id: 'audit-and-proof-links', observed: counts });

  await verifyArchiveMetadata(state);
  await verifyCandidateArchive(state, auditByPath);
  await verifyBeforeImages(state, beforeByPath);

  const { restores, originalBefore } = await inspectDestinations(
    state,
    auditByPath,
  );
  const git = await captureGitPreflight(restores);
  state.checks.push({
    id: 'git-preflight',
    observed: {
      head: git.head,
      indexIdentity: git.indexIdentity,
      indexEntryCount: git.indexEntryCount,
      baseIdenticalTargets: restores.length,
    },
  });

  const configObservations = await captureConfigConditions(state, git);

  await assertAncestorDirs(WORKSPACE, TEMP.rel);
  const tempObservation = await inspectTemp(path.join(WORKSPACE, TEMP.rel));
  state.checks.push({ id: 'interrupted-temp', observed: tempObservation });

  const quarantineRel = `${A_REL}/${QUARANTINE_NAME}`;
  const quarantineAbs = path.join(WORKSPACE, quarantineRel);
  const quarantineExisting = await lstatOrNull(quarantineAbs);
  if (quarantineExisting) refuse('QUARANTINE_EXISTS', quarantineRel);
  state.checks.push({
    id: 'quarantine-destination',
    observed: { path: quarantineRel, present: false },
  });

  const receiptPresent = await lstatOrNull(
    path.join(WORKSPACE, ATTEMPT_REL, 'receipt.json'),
  );
  if (receiptPresent) refuse('ATTEMPT_RECEIPT_PRESENT');
  state.checks.push({ id: 'attempt-receipt-absent', observed: true });

  return {
    restores,
    originalBefore,
    beforeRecords: [...beforeByPath.entries()].map(([relPath, sha256]) => ({
      path: relPath,
      sha256,
    })),
    configObservations,
    indexIdentity: git.indexIdentity,
    indexEntryCount: git.indexEntryCount,
    head: git.head,
    quarantineRel,
  };
}

async function removeOwnedTemp(tempPath, identity) {
  const stat = await lstatOrNull(tempPath);
  if (!stat) return { ok: true };
  if (stat.dev !== identity.dev || stat.ino !== identity.ino) {
    return { ok: false, code: 'TEMP_IDENTITY_MISMATCH' };
  }
  try {
    await fs.unlink(tempPath);
  } catch (error) {
    return { ok: false, code: `TEMP_UNLINK_FAILED_${error.code ?? 'UNKNOWN'}` };
  }
  return { ok: true };
}

async function restoreOne(target, journal) {
  const destinationAbs = path.join(WORKSPACE, target.path);
  const beforeImageRel = `${ATTEMPT_REL}/publication-before/${target.path}`;
  const beforeImageAbs = path.join(WORKSPACE, beforeImageRel);

  await assertAncestorDirs(WORKSPACE, target.path, false);
  const active = await digestFile(destinationAbs);
  if (!active.ok) refuse('RESTORE_DESTINATION_UNREADABLE', target.path);
  if (active.sha256 !== target.candidateSha256) {
    refuse('RESTORE_CANDIDATE_DRIFT', target.path);
  }
  const destinationMode = active.mode;

  await assertAncestorDirs(WORKSPACE, beforeImageRel, false);
  const image = await digestFile(beforeImageAbs);
  if (!image.ok) refuse('RESTORE_BEFORE_IMAGE_UNREADABLE', target.path);
  if (image.sha256 !== target.beforeSha256) {
    refuse('RESTORE_BEFORE_IMAGE_DRIFT', target.path);
  }

  const tempPath = path.join(
    path.dirname(destinationAbs),
    `.ags-restore-${process.pid}-${randomBytes(8).toString('hex')}`,
  );
  let handle = null;
  let tempIdentity = null;
  let renamed = false;
  let failure = null;

  try {
    handle = await fs.open(tempPath, 'wx', destinationMode);
    const createdStat = await fs.lstat(tempPath);
    if (createdStat.isSymbolicLink() || !createdStat.isFile()) {
      refuse('RESTORE_TEMP_NOT_REGULAR', target.path);
    }
    tempIdentity = { dev: createdStat.dev, ino: createdStat.ino };
    await handle.writeFile(image.bytes);
    await handle.chmod(destinationMode);
    await handle.sync();
    await handle.close();
    handle = null;

    const tempInfo = await digestFile(tempPath);
    if (!tempInfo.ok || tempInfo.sha256 !== target.beforeSha256) {
      refuse('RESTORE_TEMP_VERIFICATION_FAILED', target.path);
    }

    await assertAncestorDirs(WORKSPACE, target.path, false);
    const lastLook = await digestFile(destinationAbs);
    if (!lastLook.ok || lastLook.sha256 !== target.candidateSha256) {
      refuse('RESTORE_CANDIDATE_DRIFT_BEFORE_RENAME', target.path);
    }

    await fs.rename(tempPath, destinationAbs);
    renamed = true;
    await journal.record({
      action: 'RESTORE_OUTPUT',
      phase: 'renamed',
      path: target.path,
      beforeSha256: target.beforeSha256,
      candidateSha256: target.candidateSha256,
      destinationMode: modeOctal(destinationMode),
    });
  } catch (error) {
    failure = error;
  }

  if (handle) {
    try {
      await handle.close();
    } catch (error) {
      if (!failure) {
        failure = new Refusal(
          'RESTORE_TEMP_CLOSE_FAILED',
          `${target.path}:${error.code ?? 'UNKNOWN'}`,
        );
      }
    }
  }

  if (!renamed && tempIdentity) {
    const cleanup = await removeOwnedTemp(tempPath, tempIdentity);
    if (!cleanup.ok && !failure) {
      failure = new Refusal(
        'RESTORE_TEMP_CLEANUP_FAILED',
        `${target.path}:${cleanup.code}`,
      );
    }
  }

  if (failure) throw failure;

  const restored = await digestFile(destinationAbs);
  if (!restored.ok || restored.sha256 !== target.beforeSha256) {
    refuse('RESTORE_VERIFICATION_FAILED', target.path);
  }
  if (restored.mode !== destinationMode) {
    refuse('RESTORE_MODE_NOT_PRESERVED', target.path);
  }
  await journal.record({
    action: 'RESTORE_OUTPUT',
    phase: 'verified',
    path: target.path,
    restoredSha256: restored.sha256,
    destinationMode: modeOctal(restored.mode),
  });

  return {
    path: target.path,
    beforeSha256: target.beforeSha256,
    candidateSha256: target.candidateSha256,
    restoredSha256: restored.sha256,
    destinationMode: modeOctal(restored.mode),
    renameRecorded: true,
    verified: true,
  };
}

async function quarantineTemp(state) {
  const tempAbs = path.join(WORKSPACE, TEMP.rel);
  const quarantineAbs = path.join(WORKSPACE, state.plan.quarantineRel);

  const preMove = await inspectTemp(tempAbs);
  const existing = await lstatOrNull(quarantineAbs);
  if (existing) refuse('QUARANTINE_EXISTS', state.plan.quarantineRel);

  try {
    await fs.mkdir(quarantineAbs, { mode: 0o700 });
  } catch (error) {
    if (error.code === 'EEXIST') {
      refuse('QUARANTINE_EXISTS', state.plan.quarantineRel);
    }
    throw error;
  }
  const quarantineStat = await fs.lstat(quarantineAbs);
  if (quarantineStat.isSymbolicLink() || !quarantineStat.isDirectory()) {
    refuse('QUARANTINE_NOT_DIRECTORY', state.plan.quarantineRel);
  }
  if ((quarantineStat.mode & 0o777) !== 0o700) {
    refuse('QUARANTINE_MODE_MISMATCH', state.plan.quarantineRel);
  }

  const destinationAbs = path.join(quarantineAbs, path.basename(TEMP.rel));
  const occupant = await lstatOrNull(destinationAbs);
  if (occupant) refuse('QUARANTINE_OCCUPANT_EXISTS', state.plan.quarantineRel);

  await fs.rename(tempAbs, destinationAbs);
  await state.journal.record({
    action: 'QUARANTINE_TEMP',
    phase: 'renamed',
    from: TEMP.rel,
    to: `${state.plan.quarantineRel}/${path.basename(TEMP.rel)}`,
    preMovePayloadSha256: preMove.payloadSha256,
  });

  const sourceRemaining = await lstatOrNull(tempAbs);
  if (sourceRemaining) refuse('QUARANTINE_SOURCE_REMAINS');

  const postMove = await inspectTemp(destinationAbs);
  await state.journal.record({
    action: 'QUARANTINE_TEMP',
    phase: 'verified',
    to: `${state.plan.quarantineRel}/${path.basename(TEMP.rel)}`,
    payloadSha256: postMove.payloadSha256,
    directoryInode: postMove.directoryInode,
    payloadInode: postMove.payloadInode,
  });

  return {
    from: TEMP.rel,
    to: `${state.plan.quarantineRel}/${path.basename(TEMP.rel)}`,
    quarantineDirectory: state.plan.quarantineRel,
    quarantineMode: modeOctal(quarantineStat.mode),
    directoryMode: postMove.directoryMode,
    payloadMode: postMove.payloadMode,
    device: postMove.device,
    directoryInode: postMove.directoryInode,
    payloadInode: postMove.payloadInode,
    payloadSha256: postMove.payloadSha256,
    sourceRemoved: true,
  };
}

async function finalVerification(state) {
  const plan = state.plan;
  let verifiedDestinations = 0;
  for (const record of plan.beforeRecords) {
    if (record.path === LEDGER_REL) continue;
    const info = await digestFile(path.join(WORKSPACE, record.path));
    if (!info.ok) {
      refuse('FINAL_DESTINATION_UNREADABLE', `${record.path}:${info.code}`);
    }
    if (info.sha256 !== record.sha256) {
      refuse('FINAL_DESTINATION_NOT_RESTORED', record.path);
    }
    verifiedDestinations += 1;
  }
  if (plan.beforeRecords.length !== 96) refuse('FINAL_BEFORE_RECORD_COUNT');
  if (verifiedDestinations !== 95) refuse('FINAL_DESTINATION_COUNT');

  const ledgerStat = await lstatOrNull(path.join(WORKSPACE, LEDGER_REL));
  if (ledgerStat) refuse('FINAL_LEDGER_PRESENT');

  const headResult = runGit(['rev-parse', '--verify', 'HEAD']);
  if (!headResult.ok) refuse('FINAL_GIT_HEAD_UNREADABLE');
  const head = headResult.stdout.toString('utf8').trim();
  if (head !== plan.head) refuse('FINAL_HEAD_DRIFT');

  const indexResult = runGit(['ls-files', '--stage', '-z']);
  if (!indexResult.ok) refuse('FINAL_GIT_INDEX_UNREADABLE');
  const indexIdentity = indexIdentityOf(indexResult.stdout, head);
  if (indexIdentity !== plan.indexIdentity) {
    refuse('FINAL_INDEX_IDENTITY_DRIFT');
  }

  for (const observation of plan.configObservations) {
    const live = await digestFile(path.join(WORKSPACE, observation.path));
    const liveSha256 = live.ok ? live.sha256 : null;
    if (liveSha256 !== observation.sha256) {
      refuse('FINAL_CONFIG_DRIFT', observation.path);
    }
  }

  const quarantined = await inspectTemp(
    path.join(WORKSPACE, state.plan.quarantineRel, path.basename(TEMP.rel)),
  );
  if (quarantined.payloadSha256 !== TEMP.payloadSha256) {
    refuse('FINAL_QUARANTINE_PAYLOAD_MISMATCH');
  }

  state.finalVerification = {
    restoredDestinations: verifiedDestinations,
    ledgerAbsent: true,
    headUnchanged: true,
    indexIdentityUnchanged: true,
    configConditionsUnchanged: true,
    quarantinePayloadSha256: quarantined.payloadSha256,
    quarantineDirectoryInode: quarantined.directoryInode,
    quarantinePayloadInode: quarantined.payloadInode,
  };
  await state.journal.record({
    action: 'FINAL_VERIFICATION',
    phase: 'verified',
    ...state.finalVerification,
  });
}

async function applyPlan(state) {
  for (const target of state.plan.restores) {
    const effect = await restoreOne(target, state.journal);
    state.effects.push(effect);
  }
  state.quarantine = await quarantineTemp(state);
  await finalVerification(state);
}

function describeRefusal(error) {
  if (error instanceof Refusal) {
    return { code: error.code, detail: error.detail };
  }
  if (error && typeof error.code === 'string') {
    return { code: `NODE_${error.code}`, detail: null };
  }
  return {
    code: 'UNEXPECTED_ERROR',
    detail: String(error?.message ?? error ?? 'unknown'),
  };
}

const LIMITS = [
  'This operator performs one audited restoration; it is not a generation receipt and never claims the interrupted generation completed.',
  'Staged lock bytes and staged ownership are not consulted as authority; no ownership ledger is written or inferred.',
  'No automatic rollback: a partially applied transaction retains its journal and fails truthfully.',
  'Cooperative, single-writer protection only; checks and effects are not hostile-writer atomic and the interrupted transaction was never atomic.',
  'Restoration intentionally undoes known generated effects for the 15 audited paths; the interrupted attempt remains an unresolved, non-completed generation event.',
  'Only the pinned interrupted temporary directory is quarantined; no wildcard cleanup of .ags-tmp-* is authorized.',
];

async function writeReceipt(state) {
  const receipt = {
    schemaVersion: 1,
    kind: 'INTERRUPTED_PUBLICATION_EXACT_RESTORATION_OPERATOR',
    status: state.status,
    mode: state.apply ? 'apply' : 'dry-run',
    workspace: WORKSPACE,
    base: BASE,
    startedAt: state.startedAt,
    finishedAt: new Date().toISOString(),
    checks: state.checks,
    plan: state.plan
      ? {
          restoreTargets: state.plan.restores.map((target) => ({
            path: target.path,
            beforeSha256: target.beforeSha256,
            candidateSha256: target.candidateSha256,
          })),
          untouchedOriginalBefore: state.plan.originalBefore.length,
          quarantine: `${state.plan.quarantineRel}/${path.basename(TEMP.rel)}`,
          indexIdentity: state.plan.indexIdentity,
          indexEntryCount: state.plan.indexEntryCount,
        }
      : null,
    dryRun: state.apply
      ? null
      : {
          plannedRestores: state.plan?.restores.length ?? null,
          plannedQuarantine: state.plan
            ? `${state.plan.quarantineRel}/${path.basename(TEMP.rel)}`
            : null,
          mutatingEffectsPerformed: 0,
        },
    effects: state.apply ? state.effects : [],
    quarantine: state.quarantine ?? null,
    finalVerification: state.finalVerification ?? null,
    error: state.error ?? null,
    claimReleaseError: state.claimReleaseError ?? null,
    journalCloseError: state.journalCloseError ?? null,
    limits: LIMITS,
  };
  await fs.writeFile(
    path.join(state.outAbs, 'receipt.json'),
    `${JSON.stringify(receipt, null, 2)}\n`,
    { flag: 'wx', mode: 0o600 },
  );
}

async function execute(args) {
  await assertWorkspace();
  const outAbs = await prepareEvidenceDir(args.out);

  const state = {
    apply: args.apply,
    outAbs,
    startedAt: new Date().toISOString(),
    checks: [],
    effects: [],
    plan: null,
    quarantine: null,
    finalVerification: null,
    error: null,
    status: 'STARTED',
    claimReleaseError: null,
    journalCloseError: null,
  };

  const journalHandle = await fs.open(
    path.join(outAbs, 'journal.jsonl'),
    'wx',
    0o600,
  );
  state.journal = new Journal(journalHandle);

  let claim = null;
  try {
    claim = await acquireClaim(
      args.apply ? 'apply' : 'dry-run',
      toPosix(path.relative(WORKSPACE, outAbs)),
    );
    state.plan = await preflight(state);
    if (args.apply) {
      await applyPlan(state);
      state.status = 'APPLIED_AND_VERIFIED';
    } else {
      state.status = 'DRY_RUN_OK';
    }
  } catch (error) {
    state.error = describeRefusal(error);
    state.status =
      args.apply && state.effects.length > 0
        ? 'APPLY_FAILED_PARTIAL_JOURNAL_RETAINED'
        : args.apply
          ? 'APPLY_REFUSED'
          : 'REFUSED';
  } finally {
    if (claim) {
      const releaseFailure = await releaseClaim(claim);
      if (releaseFailure) {
        state.claimReleaseError = releaseFailure;
        if (
          state.status === 'DRY_RUN_OK' ||
          state.status === 'APPLIED_AND_VERIFIED'
        ) {
          state.status = 'CLAIM_RELEASE_FAILED';
        }
      }
    }
    try {
      await state.journal.close();
    } catch (error) {
      state.journalCloseError = String(error.code ?? 'UNKNOWN');
      if (
        state.status === 'DRY_RUN_OK' ||
        state.status === 'APPLIED_AND_VERIFIED'
      ) {
        state.status = 'JOURNAL_CLOSE_FAILED';
      }
    }
  }

  await writeReceipt(state);
  return state;
}

async function main() {
  let args;
  try {
    args = parseArgs(process.argv.slice(2));
  } catch (error) {
    process.stderr.write(`refused: ${error.code}\n${USAGE}`);
    return 2;
  }
  if (args.help) {
    process.stdout.write(USAGE);
    return 0;
  }

  try {
    const state = await execute(args);
    const summary = {
      status: state.status,
      mode: state.apply ? 'apply' : 'dry-run',
      evidence: toPosix(path.relative(WORKSPACE, state.outAbs)),
      plannedRestores: state.plan ? state.plan.restores.length : null,
      appliedRestores: state.effects.length,
      quarantined: state.quarantine ? state.quarantine.to : null,
      error: state.error,
    };
    process.stdout.write(`${JSON.stringify(summary)}\n`);
    return state.status === 'DRY_RUN_OK' ||
      state.status === 'APPLIED_AND_VERIFIED'
      ? 0
      : 1;
  } catch (error) {
    process.stderr.write(
      `${JSON.stringify({
        status: 'REFUSED',
        code: error?.code ?? 'UNEXPECTED_ERROR',
        message: String(error?.detail ?? error?.message ?? 'unknown'),
      })}\n`,
    );
    return 1;
  }
}

process.exitCode = await main();

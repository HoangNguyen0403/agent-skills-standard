+++ b/scripts/generation/isolated-stage.ts
@@ -0,0 +1,439 @@
+import fs from 'fs-extra';
+import path from 'path';
+import crypto from 'crypto';
+import { spawn } from 'child_process';
+
+export interface IsolatedStageOptions {
+  repoRoot: string;
+  checkOnly?: boolean;
+  attemptId?: string;
+  logDir?: string;
+}
+
+export interface IsolatedStageResult {
+  success: boolean;
+  attemptId: string;
+  checkOnly: boolean;
+  copiedBackFiles: string[];
+  logPath: string;
+  receiptPath: string;
+  error?: string;
+}
+
+export function computeSha256(content: Buffer | string): string {
+  return crypto.createHash('sha256').update(content).digest('hex');
+}
+
+export async function fileSha256(filePath: string): Promise<string | null> {
+  if (!(await fs.pathExists(filePath))) return null;
+  const buf = await fs.readFile(filePath);
+  return computeSha256(buf);
+}
+
+/**
+ * Validates configured host category IDs against canonical configured selections,
+ * not equality alone (Task 1 invariant).
+ */
+export function validateCategorySelections(
+  configuredCategoryIds: string[],
+  availableCategoryIds: string[],
+): { valid: boolean; missing: string[] } {
+  const availableSet = new Set(availableCategoryIds);
+  const missing = configuredCategoryIds.filter((id) => !availableSet.has(id));
+  return {
+    valid: missing.length === 0,
+    missing,
+  };
+}
+
+/**
+ * Copies source directory to stage excluding .git, .agent, artifacts, node_modules,
+ * and preserves complete mirror inventory.
+ */
+export async function copySourceToStage(
+  srcDir: string,
+  destDir: string,
+): Promise<void> {
+  const excludePatterns = [
+    '.git',
+    '.agent',
+    'artifacts',
+    'node_modules',
+    '.husky/_',
+  ];
+
+  await fs.ensureDir(destDir);
+  await fs.copy(srcDir, destDir, {
+    filter: (src: string) => {
+      const rel = path.relative(srcDir, src);
+      if (!rel) return true;
+      const parts = rel.split(path.sep);
+      for (const excluded of excludePatterns) {
+        if (parts.includes(excluded)) return false;
+      }
+      return true;
+    },
+    dereference: false,
+    preserveTimestamps: true,
+  });
+}
+
+/**
+ * Explicitly links existing node_modules from repoRoot into staged directory
+ * so dependencies are reused without npm/pnpm install in the temporary stage.
+ */
+export async function linkDependencies(
+  repoRoot: string,
+  stageDir: string,
+): Promise<void> {
+  const rootNodeModules = path.join(repoRoot, 'node_modules');
+  const stageNodeModules = path.join(stageDir, 'node_modules');
+
+  if (await fs.pathExists(rootNodeModules)) {
+    if (!(await fs.pathExists(stageNodeModules))) {
+      await fs.symlink(rootNodeModules, stageNodeModules, 'junction');
+    }
+  }
+
+  // Also link cli/node_modules if present
+  const cliNodeModules = path.join(repoRoot, 'cli', 'node_modules');
+  const stageCliNodeModules = path.join(stageDir, 'cli', 'node_modules');
+  if (await fs.pathExists(cliNodeModules)) {
+    await fs.ensureDir(path.join(stageDir, 'cli'));
+    if (!(await fs.pathExists(stageCliNodeModules))) {
+      await fs.symlink(cliNodeModules, stageCliNodeModules, 'junction');
+    }
+  }
+}
+
+/**
+ * Runs an isolated command inside a stage working directory.
+ */
+export function runInStage(
+  command: string,
+  args: string[],
+  cwd: string,
+): Promise<{ exitCode: number; stdout: string; stderr: string }> {
+  const { promise, resolve } = Promise.withResolvers<{
+    exitCode: number;
+    stdout: string;
+    stderr: string;
+  }>();
+
+  let stdout = '';
+  let stderr = '';
+  const child = spawn(command, args, {
+    cwd,
+    env: { ...process.env, CI: 'true' },
+    shell: false,
+  });
+
+  child.stdout?.on('data', (d: Buffer) => {
+    stdout += d.toString();
+  });
+  child.stderr?.on('data', (d: Buffer) => {
+    stderr += d.toString();
+  });
+
+  child.on('close', (code: number | null) => {
+    resolve({ exitCode: code ?? 1, stdout, stderr });
+  });
+  child.on('error', (err: Error) => {
+    stderr += `\nProcess error: ${err.message}`;
+    resolve({ exitCode: 1, stdout, stderr });
+  });
+
+  return promise;
+}
+
+/**
+ * Main coordinator for safe staged generation.
+ */
+export async function runIsolatedGeneration(
+  options: IsolatedStageOptions,
+): Promise<IsolatedStageResult> {
+  const repoRoot = path.resolve(options.repoRoot);
+  const physicalCwd = path.resolve(process.cwd());
+
+  if (physicalCwd !== repoRoot) {
+    throw new Error(
+      `Refusing isolated generation from foreign working directory: cwd is "${physicalCwd}", repoRoot is "${repoRoot}".`,
+    );
+  }
+
+  const attemptId =
+    options.attemptId ||
+    `attempt-${new Date().toISOString().replace(/[:.]/g, '-')}-${Math.random().toString(36).slice(2, 8)}`;
+  const logDir =
+    options.logDir ||
+    path.join(repoRoot, 'artifacts', 'generation-logs', attemptId);
+  await fs.ensureDir(logDir);
+
+  const logPath = path.join(logDir, 'generation.log');
+  const receiptPath = path.join(logDir, 'receipt.json');
+
+  // Verify that an attempt directory cannot overwrite an existing attempt log
+  if (await fs.pathExists(logPath)) {
+    throw new Error(
+      `Attempt log already exists at "${logPath}". Cannot overwrite prior logs.`,
+    );
+  }
+
+  const checkOnly = Boolean(options.checkOnly);
+  const tempStageDir = path.join(
+    path.dirname(repoRoot),
+    `.isolated-stage-${attemptId}`,
+  );
+
+  let stageLogContent = `[Isolated Generation Run] attempt=${attemptId} checkOnly=${checkOnly}\n`;
+
+  try {
+    // Verify configured category selection containment
+    const metadataPath = path.join(repoRoot, 'skills', 'metadata.json');
+    if (await fs.pathExists(metadataPath)) {
+      const metadata = await fs.readJson(metadataPath);
+      const availableCategories = Object.keys(metadata.categories || {});
+      const skillsDir = path.join(repoRoot, 'skills');
+      const diskCategories = (await fs.readdir(skillsDir)).filter((f) => {
+        const p = path.join(skillsDir, f);
+        return fs.statSync(p).isDirectory() && !f.startsWith('.');
+      });
+
+      const check = validateCategorySelections(
+        availableCategories,
+        diskCategories,
+      );
+      if (!check.valid) {
+        throw new Error(
+          `Configured category selections missing on disk: ${check.missing.join(', ')}`,
+        );
+      }
+    }
+
+    // Declared candidate generated files
+    const declaredGeneratedFiles = [
+      'skills/metadata.json',
+      'skills/index.json',
+      'README.md',
+      'AGENTS.md',
+      'docs/agent-capabilities.md',
+    ];
+
+    // Baseline all intended destination bytes/absence BEFORE running generator
+    const baselineDigests = new Map<string, string | null>();
+    for (const rel of declaredGeneratedFiles) {
+      const destPath = path.join(repoRoot, rel);
+      if (await fs.pathExists(destPath)) {
+        const stat = await fs.lstat(destPath);
+        if (stat.isSymbolicLink()) {
+          throw new Error(
+            `Destination file is a symbolic link: "${destPath}". Rejected for safety.`,
+          );
+        }
+        baselineDigests.set(rel, await fileSha256(destPath));
+      } else {
+        baselineDigests.set(rel, null);
+      }
+    }
+
+    stageLogContent += `Baselines captured for ${declaredGeneratedFiles.length} declared targets.\n`;
+
+    // Setup stage directory
+    await copySourceToStage(repoRoot, tempStageDir);
+    await linkDependencies(repoRoot, tempStageDir);
+    stageLogContent += `Staged workspace prepared at: ${tempStageDir}\n`;
+
+    // 1. Run calculate-tokens in stage
+    const tokenRun = await runInStage(
+      'node',
+      [
+        '--import',
+        'tsx',
+        path.join(tempStageDir, 'scripts', 'calculate-tokens.ts'),
+      ],
+      tempStageDir,
+    );
+    stageLogContent += `[calculate-tokens] exitCode=${tokenRun.exitCode}\nSTDOUT:\n${tokenRun.stdout}\nSTDERR:\n${tokenRun.stderr}\n`;
+    if (tokenRun.exitCode !== 0) {
+      throw new Error(
+        `calculate-tokens failed in stage with exit code ${tokenRun.exitCode}`,
+      );
+    }
+
+    // 2. Run generate-indices in stage
+    const indicesRun = await runInStage(
+      'node',
+      [
+        '--import',
+        'tsx',
+        path.join(tempStageDir, 'scripts', 'generate-indices.ts'),
+      ],
+      tempStageDir,
+    );
+    stageLogContent += `[generate-indices] exitCode=${indicesRun.exitCode}\nSTDOUT:\n${indicesRun.stdout}\nSTDERR:\n${indicesRun.stderr}\n`;
+    if (indicesRun.exitCode !== 0) {
+      throw new Error(
+        `generate-indices failed in stage with exit code ${indicesRun.exitCode}`,
+      );
+    }
+
+    // 3. Run generate-capabilities-doc in stage
+    const capRun = await runInStage(
+      'node',
+      [
+        '--import',
+        'tsx',
+        path.join(tempStageDir, 'scripts', 'generate-capabilities-doc.ts'),
+      ],
+      tempStageDir,
+    );
+    stageLogContent += `[generate-capabilities-doc] exitCode=${capRun.exitCode}\nSTDOUT:\n${capRun.stdout}\nSTDERR:\n${capRun.stderr}\n`;
+    if (capRun.exitCode !== 0) {
+      throw new Error(
+        `generate-capabilities-doc failed in stage with exit code ${capRun.exitCode}`,
+      );
+    }
+
+    // Digest comparison of staged files vs destination baselines
+    const stagedDigests = new Map<string, string | null>();
+    const outOfDateFiles: string[] = [];
+    const filesToCopyBack: string[] = [];
+
+    for (const rel of declaredGeneratedFiles) {
+      const stageFilePath = path.join(tempStageDir, rel);
+      const stagedHash = (await fs.pathExists(stageFilePath))
+        ? await fileSha256(stageFilePath)
+        : null;
+      stagedDigests.set(rel, stagedHash);
+
+      const baselineHash = baselineDigests.get(rel);
+      if (stagedHash !== baselineHash) {
+        outOfDateFiles.push(rel);
+        if (stagedHash !== null) {
+          filesToCopyBack.push(rel);
+        }
+      }
+    }
+
+    if (checkOnly) {
+      if (outOfDateFiles.length > 0) {
+        throw new Error(
+          `Generated files are out of date: ${outOfDateFiles.join(', ')}. Run staged generation in apply mode.`,
+        );
+      }
+      stageLogContent += `Check passed: all generated files match stage outputs.\n`;
+      await fs.writeFile(logPath, stageLogContent, 'utf8');
+      const receipt = {
+        attemptId,
+        timestamp: new Date().toISOString(),
+        checkOnly: true,
+        status: 'PASS',
+        declaredFiles: declaredGeneratedFiles,
+      };
+      await fs.writeJson(receiptPath, receipt, { spaces: 2 });
+      return {
+        success: true,
+        attemptId,
+        checkOnly: true,
+        copiedBackFiles: [],
+        logPath,
+        receiptPath,
+      };
+    }
+
+    // Apply mode: verify destination has not drifted since baseline was taken (concurrency check)
+    for (const rel of filesToCopyBack) {
+      const destPath = path.join(repoRoot, rel);
+      const currentDestHash = (await fs.pathExists(destPath))
+        ? await fileSha256(destPath)
+        : null;
+      const initialBaselineHash = baselineDigests.get(rel);
+
+      if (currentDestHash !== initialBaselineHash) {
+        throw new Error(
+          `Concurrent drift detected on destination file "${destPath}". Initial digest was "${initialBaselineHash}", current is "${currentDestHash}". Aborting copy-back.`,
+        );
+      }
+
+      // Check destination is still not a symlink
+      if (await fs.pathExists(destPath)) {
+        const destStat = await fs.lstat(destPath);
+        if (destStat.isSymbolicLink()) {
+          throw new Error(
+            `Destination file is a symlink: "${destPath}". Aborting copy-back.`,
+          );
+        }
+      }
+    }
+
+    // Perform atomic copy-back
+    for (const rel of filesToCopyBack) {
+      const stageFilePath = path.join(tempStageDir, rel);
+      const destPath = path.join(repoRoot, rel);
+      await fs.copy(stageFilePath, destPath, {
+        overwrite: true,
+        errorOnExist: false,
+        dereference: false,
+      });
+      stageLogContent += `Copied back: ${rel}\n`;
+    }
+
+    stageLogContent += `Successfully completed staged generation and copy-back.\n`;
+    await fs.writeFile(logPath, stageLogContent, 'utf8');
+
+    const receipt = {
+      attemptId,
+      timestamp: new Date().toISOString(),
+      checkOnly: false,
+      status: 'APPLIED',
+      copiedBackFiles: filesToCopyBack,
+      declaredFiles: declaredGeneratedFiles,
+    };
+    await fs.writeJson(receiptPath, receipt, { spaces: 2 });
+
+    return {
+      success: true,
+      attemptId,
+      checkOnly: false,
+      copiedBackFiles: filesToCopyBack,
+      logPath,
+      receiptPath,
+    };
+  } catch (error: unknown) {
+    const errorMsg = error instanceof Error ? error.message : String(error);
+    stageLogContent += `\nFAILURE: ${errorMsg}\n`;
+    try {
+      await fs.writeFile(logPath, stageLogContent, 'utf8');
+      await fs.writeJson(
+        receiptPath,
+        {
+          attemptId,
+          timestamp: new Date().toISOString(),
+          status: 'FAILED',
+          error: errorMsg,
+        },
+        { spaces: 2 },
+      );
+    } catch {
+      // ignore logging write errors
+    }
+    return {
+      success: false,
+      attemptId,
+      checkOnly,
+      copiedBackFiles: [],
+      logPath,
+      receiptPath,
+      error: errorMsg,
+    };
+  } finally {
+    // Teardown temporary stage directory
+    try {
+      if (await fs.pathExists(tempStageDir)) {
+        await fs.remove(tempStageDir);
+      }
+    } catch {
+      // ignore stage cleanup errors
+    }
+  }
+}

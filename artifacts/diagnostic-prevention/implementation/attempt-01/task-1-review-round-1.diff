+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'fs-extra';
+import path from 'path';
+import os from 'os';
+import {
+  copySourceToStage,
+  validateCategorySelections,
+  runIsolatedGeneration,
+  fileSha256,
+} from './isolated-stage';
+
+test('copySourceToStage excludes .git, .agent, artifacts, and node_modules while retaining mirrors', async () => {
+  const tmpRoot = await fs.mkdtemp(path.join(os.tmpdir(), 'stage-copy-test-'));
+  const stageDest = path.join(tmpRoot, 'stage');
+
+  try {
+    // Setup dummy source structure
+    await fs.outputFile(path.join(tmpRoot, '.git', 'HEAD'), 'ref: refs/heads/main\n');
+    await fs.outputFile(path.join(tmpRoot, '.agent', 'sdd', 'evidence.md'), 'secret evidence\n');
+    await fs.outputFile(path.join(tmpRoot, 'artifacts', 'run-1', 'receipt.json'), '{"run":1}\n');
+    await fs.outputFile(path.join(tmpRoot, 'node_modules', 'dep', 'index.js'), 'module.exports = {};\n');
+    await fs.outputFile(path.join(tmpRoot, 'skills', 'common', 'SKILL.md'), '# Common skill\n');
+    await fs.outputFile(path.join(tmpRoot, '.agents', 'skills', 'common', 'SKILL.md'), '# Mirrored skill\n');
+
+    await copySourceToStage(tmpRoot, stageDest);
+
+    // Verify exclusions
+    assert.equal(await fs.pathExists(path.join(stageDest, '.git')), false, '.git must be excluded');
+    assert.equal(await fs.pathExists(path.join(stageDest, '.agent')), false, '.agent must be excluded');
+    assert.equal(await fs.pathExists(path.join(stageDest, 'artifacts')), false, 'artifacts must be excluded');
+    assert.equal(await fs.pathExists(path.join(stageDest, 'node_modules')), false, 'node_modules must be excluded');
+
+    // Verify retained complete inventory
+    assert.equal(await fs.pathExists(path.join(stageDest, 'skills', 'common', 'SKILL.md')), true, 'source skill retained');
+    assert.equal(await fs.pathExists(path.join(stageDest, '.agents', 'skills', 'common', 'SKILL.md')), true, 'mirror inventory retained');
+  } finally {
+    await fs.remove(tmpRoot);
+  }
+});
+
+test('validateCategorySelections detects missing disk categories against configured selections', () => {
+  const configured = ['typescript', 'common', 'missing-cat'];
+  const available = ['typescript', 'common', 'python', 'database'];
+
+  const result = validateCategorySelections(configured, available);
+  assert.equal(result.valid, false);
+  assert.deepEqual(result.missing, ['missing-cat']);
+
+  const validResult = validateCategorySelections(['typescript', 'common'], available);
+  assert.equal(validResult.valid, true);
+  assert.deepEqual(validResult.missing, []);
+});
+
+test('foreign cwd refuses isolated generation before mutation or reads', async () => {
+  const fakeRepo = '/some/foreign/repo/path';
+  await assert.rejects(
+    async () => {
+      await runIsolatedGeneration({
+        repoRoot: fakeRepo,
+      });
+    },
+    /Refusing isolated generation from foreign working directory/,
+  );
+});
+
+test('repeated attempt cannot overwrite prior logs', async () => {
+  const tmpRoot = await fs.mkdtemp(path.join(os.tmpdir(), 'attempt-log-test-'));
+  const logDir = path.join(tmpRoot, 'logs', 'fixed-attempt');
+  await fs.ensureDir(logDir);
+  await fs.outputFile(path.join(logDir, 'generation.log'), 'existing attempt log\n');
+
+  try {
+    // Should fail closed when logPath already exists
+    await assert.rejects(
+      async () => {
+        await runIsolatedGeneration({
+          repoRoot: process.cwd(),
+          attemptId: 'fixed-attempt',
+          logDir,
+        });
+      },
+      /Attempt log already exists.*Cannot overwrite prior logs/,
+    );
+  } finally {
+    await fs.remove(tmpRoot);
+  }
+});
+
+test('baseline drift or modified destination aborts copy-back leaving destination untouched', async () => {
+  const tmpRoot = await fs.mkdtemp(path.join(os.tmpdir(), 'drift-test-'));
+  try {
+    const fileA = path.join(tmpRoot, 'target.md');
+    await fs.outputFile(fileA, 'initial-content\n');
+    const initialDigest = await fileSha256(fileA);
+
+    // Simulate concurrent modification
+    await fs.outputFile(fileA, 'modified-by-concurrent-process\n');
+    const modifiedDigest = await fileSha256(fileA);
+    assert.notEqual(initialDigest, modifiedDigest);
+  } finally {
+    await fs.remove(tmpRoot);
+  }
+});

+// ============================================================================
+// 10. Manifest and Source Digest Binding Integrity
+// ============================================================================
+
+test("digest binding: source hash mismatch detects mutated eval cases or modified guidance", () => {
+  const originalSource = "{\"skill_name\": \"common-tdd\", \"evals\": [{\"id\": 1}]}";
+  const modifiedSource = "{\"skill_name\": \"common-tdd\", \"evals\": [{\"id\": 1, \"tampered\": true}]}";
+
+  const originalHash = crypto.createHash("sha256").update(originalSource).digest("hex");

+// ============================================================================
+// 9. Routing Negatives (should_not_trigger)
+// ============================================================================
+
+test("routing negatives: should_not_trigger queries do not match skill keywords", () => {
+  const telemetryNegativeQuery = "Design a logo for a marketing landing page.";
+  const securityNegativeQuery = "Write a React hook for fetching data.";

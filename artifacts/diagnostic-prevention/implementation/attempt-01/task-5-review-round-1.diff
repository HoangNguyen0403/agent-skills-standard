+  );
+});
+
+// ============================================================================
+// 8. Multi-Assertion Partial Compliance Failure
+// ============================================================================
+
+test("eval scoring: partial compliance satisfies single assertions but fails overall case pass", () => {
+  const multiAssertions: Assertion[] = [
+    { type: "contains", value: "unexpected_green" },
+    { type: "contains", value: "inspect existing coverage" },
+    { type: "contains", value: "do not implement production code" },

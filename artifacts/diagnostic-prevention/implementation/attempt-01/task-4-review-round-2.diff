 ```
+
+## Operation-Private Capability Minting & Atomic Transaction-Time Revalidation
+
+```typescript
+// Privileged operation-private capability token contract
+interface PrivilegedOperationToken {
+  readonly operationId: string;
+  readonly issuerId: string;
+  readonly scope: 'vault:transfer';
+  readonly expiresAt: number;
+  readonly signature: string;
+}
+
+class OperationCapabilityAuthority {
+  private constructor(private readonly signingKey: Buffer) {}
+
+  // Private mint: issued strictly for a single high-risk operation
+  static mintPrivilegedCapability(
+    operationId: string,
+    trustedSecurityContext: SecurityContext,
+    signingKey: Buffer
+  ): PrivilegedOperationToken {
+    const payload = {
+      operationId,
+      issuerId: trustedSecurityContext.authenticatedPrincipalId,
+      scope: 'vault:transfer' as const,
+      expiresAt: Date.now() + 30_000, // 30-second single-operation lifetime
+    };
+    const signature = cryptoService.sign(JSON.stringify(payload), signingKey);
+    return { ...payload, signature };
+  }
+
+  // Validator-only verification: consumes and invalidates capability
+  static verifyPrivilegedCapability(
+    token: PrivilegedOperationToken,
+    expectedOperationId: string,
+    expectedPrincipalId: string,
+    signingKey: Buffer
+  ): boolean {
+    if (token.operationId !== expectedOperationId) return false;
+    if (token.issuerId !== expectedPrincipalId) return false;
+    if (Date.now() > token.expiresAt) return false;
+    const { signature, ...payload } = token;
+    return cryptoService.verify(JSON.stringify(payload), signature, signingKey);
+  }
+}
+
+async function executePrivilegedTransfer(
+  operationId: string,
+  securityContext: SecurityContext,
+  transferPayload: TransferDto,
+  signingKey: Buffer
+): Promise<Receipt> {
+  // Authenticated principal identity MUST be resolved from verified securityContext,
+  // never caller-supplied unauthenticated payload claims.
+  const principalId = securityContext.authenticatedPrincipalId;
+
+  // Mint capability strictly for this single privileged operation
+  const capability = OperationCapabilityAuthority.mintPrivilegedCapability(
+    operationId,
+    securityContext,
+    signingKey
+  );
+
+  // Atomic execution: validate authority, verify capability, check balance,
+  // and commit inside the SAME writer transaction to eliminate race conditions.
+  return db.transaction(async (tx) => {
+    // 1. Verify capability inside transaction
+    const validCap = OperationCapabilityAuthority.verifyPrivilegedCapability(
+      capability,
+      operationId,
+      principalId,
+      signingKey
+    );
+    if (!validCap) {
+      throw new UnauthorizedException('Privileged capability invalid or expired');
+    }
+
+    // 2. Transaction-time revalidation against primary authority store with row lock
+    const [account] = await tx.query(
+      'SELECT balance, status, authority_epoch FROM accounts WHERE id = $1 FOR UPDATE',
+      [transferPayload.sourceAccount]
+    );
+    if (!account || account.status !== 'ACTIVE') {
+      throw new UnauthorizedException('Account not authorized or inactive');
+    }
+    if (account.balance < transferPayload.amount) {
+      throw new InsufficientFundsException();
+    }
+
+    // 3. Commit mutation atomically
+    await tx.query(
+      'UPDATE accounts SET balance = balance - $1 WHERE id = $2',
+      [transferPayload.amount, transferPayload.sourceAccount]
+    );
+    await tx.query(
+      'UPDATE accounts SET balance = balance + $1 WHERE id = $2',
+      [transferPayload.amount, transferPayload.destinationAccount]
+    );
+
+    // 4. Record authenticated audit evidence inside the same transaction
+    await recordAuditEventTx(tx, {
+      eventId: cryptoService.randomUUID(),
+      operationId,
+      callerPrincipal: principalId, // Trusted authenticated principal
+      action: 'vault:transfer',
+      details: { amount: transferPayload.amount, to: transferPayload.destinationAccount },
+      timestamp: new Date().toISOString(),
+    });
+
+    return { operationId, status: 'SUCCESS' };
+  });
+}
+
+## Authenticated Persisted Evidence
+
+```typescript
+// Persist audit records with caller provenance and tamper evidence inside the transaction
+interface AuditEventPayload {
+  eventId: string;
+  operationId: string;
+  callerPrincipal: string; // From trusted auth context, not caller input
+  action: string;
+  details: Record<string, unknown>;
+  timestamp: string;
+}
+
+async function recordAuditEventTx(tx: DatabaseTransaction, event: AuditEventPayload): Promise<void> {
+  // Record directly to tamper-evident append-only store or append signature
+  await tx.query(
+    'INSERT INTO audit_events (event_id, operation_id, caller_principal, action, details, timestamp) VALUES ($1, $2, $3, $4, $5, $6)',
+    [event.eventId, event.operationId, event.callerPrincipal, event.action, JSON.stringify(event.details), event.timestamp]
+  );
+}
+```

+async function withFixture(
+  options: FixtureOptions,
+  body: (root: string) => Promise<void>,
+): Promise<void> {
+  const root = await createFixtureRepo(options);
+  const previousCwd = process.cwd();
+  process.chdir(root);
+  try {
+    await body(root);
+  } finally {
+    process.chdir(previousCwd);
+    await fs.remove(root);
+  }
+}
+
+async function withEnv<T>(
+  values: Record<string, string>,
+  body: () => Promise<T>,
+): Promise<T> {
+  for (const [key, value] of Object.entries(values)) {
+    process.env[key] = value;
+  }
+  try {
+    return await body();
+  } finally {
+    for (const key of Object.keys(values)) delete process.env[key];
+  }
+}
+
+async function git(cwd: string, args: string[]): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const child = spawn('git', args, { cwd, shell: false });
+    let stdout = '';
+    let stderr = '';
+    child.stdout?.on('data', (chunk: Buffer) => {
+      stdout += chunk.toString();
+    });
+    child.stderr?.on('data', (chunk: Buffer) => {
+      stderr += chunk.toString();
+    });
+    child.on('error', reject);
+    child.on('close', (code) => {
+      if (code !== 0) reject(new Error(`git ${args.join(' ')} failed: ${stderr}`));
+      else resolve(stdout.trim());
+    });
+  });
+}
+async function commitFixtureBase(root: string): Promise<string> {
+  await git(root, ['init', '--quiet']);
+  await git(root, ['config', 'user.name', 'Fixture']);
+  await git(root, ['config', 'user.email', 'fixture@example.invalid']);
+  await git(root, [
+    'add',
+    '--all',
+    '--',
+    '.skillsrc',
+    'AGENTS.md',
+    'LICENSE.TXT',
+    '.agents',
+    '.github',
+    'docs',
+    'skills',
+    'scripts',
+    'cli',
+  ]);
+  await git(root, ['commit', '--quiet', '-m', 'generated baseline']);
+  return git(root, ['rev-parse', 'HEAD']);
+
+}

+          `Staged host output "${relPath}" lacks matching CLI ownership metadata.`,
+        );
+      }
+    }
+    staleFiles.push(...outOfDateFiles);
+    adoptedPaths = adoptionBase
+      ? unknownExisting.filter((relPath) => outOfDateFiles.includes(relPath))
+      : [];
+    const unapprovedExisting = unknownExisting.filter(
+      (relPath) =>
+        outOfDateFiles.includes(relPath) && !adoptedPaths.includes(relPath),
+    );
+    if (unapprovedExisting.length > 0) {
+      throw new Error(
+        `${checkOnly ? 'Prepared generator outputs are stale; ' : ''}differing generated outputs lack trusted ownership or explicit base proof: ${unapprovedExisting.join(', ')}.`,
+      );
+    }
+
+    if (
+      (await currentDestinationDigest(repoRoot, '.skills-lock.json')) !==
+      lockBaselineDigest
+    ) {
+      throw new Error(
+        'Ownership manifest drifted during generation; refusing publication.',
+      );
+    }
+    const currentSourceInventory = await captureCandidateSourceInventory(
+      repoRoot,
+      plan,
+    );
+    const sourceDrift = sourceInventoryDifferences(
+      candidateInventory,
+      currentSourceInventory,
+    );
+    if (sourceDrift.length > 0) {
+      throw new Error(
+        `Candidate source inventory drifted during generation: ${sourceDrift.join(', ')}.`,
+      );
+    }
+    for (const relPath of plan.declaredFiles) {
+      const current = await currentDestinationDigest(repoRoot, relPath);
+      if (current !== baselineDigests.get(relPath)) {
+        throw new Error(
+          `Concurrent drift detected on destination "${relPath}": baseline ${baselineDigests.get(relPath)}, current ${current}. Aborting before copy-back.`,
+        );
+      }
+    }
+
+    for (const relPath of outOfDateFiles) {
+      if (stagedDigests.get(relPath) === null) {
+        throw new Error(
+          `Declared output "${relPath}" exists in the destination but not in the stage; refusing automatic deletion.`,
+        );
+      }
+    }
+
+    if (checkOnly) {
+      if (outOfDateFiles.length > 0) {
+        throw new Error(
+          `Prepared generator outputs are stale: ${outOfDateFiles.join(', ')}. Run isolated generation in apply mode.`,
+        );
+      }
+      await appendLog('Check passed: prepared outputs match declared targets.\n');
+      await fs.writeJson(
+        receiptPath,
+        {
+          attemptId,
+          timestamp: new Date().toISOString(),
+          checkOnly: true,
+          status: 'PASS',
+          declaredFiles: plan.declaredFiles,
+        },
+        { spaces: 2, flag: 'wx' },
+      );
+      return {
+        success: true,
+        attemptId,
+        checkOnly: true,
+        copiedBackFiles: [],
+        verifiedFiles: [],
+        logPath,
+        receiptPath,
+      };
+    }
+
+    if (adoptedPaths.length > 0 && adoptionBase) {
+      await archiveAdoptions(
+        logDir,
+        adoptionBase,
+        repoRoot,
+        adoptedPaths,
+        baseProofs,
+      );
+    }
+    const prepublicationInventory = await captureCandidateSourceInventory(
+      repoRoot,
+      plan,
+    );
+    const prepublicationDrift = sourceInventoryDifferences(
+      candidateInventory,
+      prepublicationInventory,
+    );
+    if (prepublicationDrift.length > 0) {
+      throw new Error(
+        `Candidate source inventory drifted before publication: ${prepublicationDrift.join(', ')}.`,
+      );
+    }
+    for (const relPath of outOfDateFiles) {
+      const stageDigest = stagedDigests.get(relPath);
+      if (!stageDigest) continue;
+      const current = await currentDestinationDigest(repoRoot, relPath);
+      if (current !== baselineDigests.get(relPath)) {
+        throw new Error(
+          `Concurrent drift detected on destination "${relPath}" before publication. Aborting.`,
+        );
+      }
+      await publishStagedFile(stageRoot, repoRoot, relPath, stageDigest, () => {
+        appliedFiles.push(relPath);
+      });
+      verifiedFiles.push(relPath);
+      await appendLog(`Published & verified: ${relPath}\n`);
+    }
+
+    const ownershipChanged = await persistVerifiedOwnership(
+      repoRoot,
+      plan,
+      outOfDateFiles,
+      stagedDigests,
+      currentLock,
+      stagedLock,
+      lockBaselineDigest,
+      () => appliedFiles.push('.skills-lock.json'),
+    );
+    const ownershipDigest = await currentDestinationDigest(
+      repoRoot,
+      '.skills-lock.json',
+    );
+    if ((ownershipChanged || currentLock) && !ownershipDigest) {
+      throw new Error('Verified output publication did not produce an ownership manifest.');
+    }
+    if (ownershipDigest && outOfDateFiles.length > 0) {
+      const verifiedLock = await readGenerationLock(repoRoot);

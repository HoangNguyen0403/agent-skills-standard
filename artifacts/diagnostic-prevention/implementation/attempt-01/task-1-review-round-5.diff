+      await fs.writeJson(
+        receiptPath,
+        {
+          attemptId,
+          timestamp: new Date().toISOString(),
+          checkOnly,
+          status: 'FAILED',
+          error: errorMsg,
+          appliedFiles,
+          verifiedFiles,
+          stagedOutOfDateFiles: staleFiles,

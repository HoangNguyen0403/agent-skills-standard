+        throw new Error(`Adoption base "${base}" is not an available full commit.`);
+      }
+      baseProofs = await proveBaseProducerOutputs(
+        repoRoot,
+        base,
+        unknownExisting,
+        appendLog,
+      );
+      for (const relPath of unknownExisting) {
+        if (baselineDigests.get(relPath) !== baseProofs.get(relPath)) {
+          throw new Error(
+            `Adoption refused for "${relPath}": current bytes do not match the recorded base blob and prior producer output.`,
+          );
+        }

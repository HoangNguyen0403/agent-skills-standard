+        { spaces: 2, flag: 'wx' },
+      );
+    } catch {
+      // A pre-existing receipt means this attempt never owned the directory.
+    }
+    return {
+      success: false,
+      attemptId,
+      checkOnly,
+      copiedBackFiles: appliedFiles,
+      verifiedFiles,
+      logPath,
+      receiptPath,
+      error: errorMsg,
+    };
+  } finally {
+    if (stageRoot) {
+      await fs.remove(stageRoot).catch(() => undefined);
+    }
+  }
+}

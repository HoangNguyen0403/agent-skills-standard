+      }
+      const resolvedBase = await runProcess(
+        'git',
+        ['rev-parse', '--verify', `${base}^{commit}`],
+        repoRoot,
+      );
+      if (
+        resolvedBase.code !== 0 ||
+        resolvedBase.stdout.toString('utf8').trim().toLowerCase() !== base

+    await fs.ensureDir(path.join(root, 'docs'));
+  }
+  await fs.outputFile(
+    path.join(root, '.github', 'instructions', 'agent-skill-standard-rule.instructions.md'),
+    '---\ndescription: rule\n---\nRead AGENTS.md\n',
+  );
+
+  // Baseline mirrors are produced by the real index/package contracts; the
+  // common category index is made stale by dropping the beta row.
+  const skillsDir = path.join(root, 'skills');
+  const realCommonIndex = await realCategoryIndexContent(skillsDir, 'common');
+  assert.match(realCommonIndex, /common-beta/, 'real producer must index beta');
+  const staleCommonIndex = stripIndexRow(realCommonIndex, 'common-beta');
+
+  await fs.outputFile(
+    path.join(root, 'skills', 'common', '_INDEX.md'),
+    staleCommonIndex,
+  );
+  const realSpecialistsIndex = await realCategoryIndexContent(
+    skillsDir,
+    'specialists',
+  );
+  await fs.outputFile(
+    path.join(root, 'skills', 'specialists', '_INDEX.md'),
+    realSpecialistsIndex,
+  );
+  await fs.outputJson(path.join(root, 'skills', 'index.json'), {
+    common: '- **[common/common-alpha]**: Alpha skill (triggers: `*.alpha`)',
+    specialists:
+      '- **[specialists/specialist-arch]**: Architecture specialist',
+  });
+
+  const mirrorSkill = async (
+    category: string,
+    skill: string,
+    files: string[],
+  ): Promise<void> => {
+    if (options.omitMirrorSkill === skill) return;
+    for (const file of files) {
+      const rel = path.posix.join('.github', 'skills', category, skill, file);
+      await fs.outputFile(
+        path.join(root, rel),
+        await fs.readFile(
+          path.join(root, 'skills', category, skill, file),
+        ),
+      );
+    }
+  };
+  await mirrorSkill('common', 'common-alpha', ['SKILL.md', 'references/details.md']);
+  await mirrorSkill('common', 'common-beta', ['SKILL.md']);
+  await fs.outputFile(
+    path.join(root, '.github', 'skills', 'common', '_INDEX.md'),
+    staleCommonIndex,
+  );
+
+  if (options.mutateDuringIndices) {
+    await fs.move(
+      path.join(root, 'scripts', 'generate-indices.ts'),
+      path.join(root, 'scripts', 'generate-indices.impl.ts'),
+    );
+    await fs.outputFile(
+      path.join(root, 'scripts', 'generate-indices.ts'),
+      GENERATE_INDICES_WRAPPER,
+    );
+  }
+
+  await fs.symlink(
+    path.join(REPOSITORY_ROOT, 'node_modules'),
+    path.join(root, 'node_modules'),
+    'junction',
+  );
+
+  return root;
+}

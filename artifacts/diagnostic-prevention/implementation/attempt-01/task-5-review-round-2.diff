+/**
+ * Task 5 Calibration Test Suite: Real-Scorer & Canonical Evaluator Verification (S03, S06)
+ *
+ * Loads actual canonical evals.json files from the candidate repository tree and evaluates
+ * independently authored transcripts using the real checkAssertion engine (scripts/evals/scorer.ts).
+ *
+ * Verifies:
+ * 1. Task 3 (common-tdd): Cases 4, 5, 7, 8, 9
+ *    - Compliant refusals quoting prohibited actions pass repaired decision controls
+ *    - Adversarial refusal-plus-violation and unanchored implementations fail
+ *    - Unobserved RED must remain NOT RUN, early zero-exit is rejected, stale source requires rerun
+ * 2. Task 2 (common-subagent-driven-development, learning-log, session-retrospective):
+ *    - SDD Cases 4, 5, 6, 7, 8, 9: Inline exception, vague assent 'proceed', archive verification,
+ *      quality vs quota routing, no recursive delegation, repeat mistake proposed status
+ *    - learning-log Case 5 & session-retrospective Case 5: proposed status & archive before cleanup
+ * 3. Task 4 (common-security-standards, common-web-visual-testing, common-telemetry):
+ *    - Security Cases 4 & 5: REJECT sibling mint / shared ledger and alternate batch API bypass
+ *    - Web Visual Testing Cases 3 & 4: REJECT synthetic auth bypass and jsdom renderer-only fixture
+ *    - Telemetry Cases 3 & 4: REJECT missing != zero coercion and conflating discovery with usage
+ *    - Negative discriminators (not_contains) and decision postures reject affirmative keyword-stuffed text
+ * 4. Multi-assertion partial compliance failure across canonical cases
+ * 5. Canonical should_not_trigger query validation against skill activation boundaries
+ * 6. Scorer manifest source-hash and resource fingerprint binding contract
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import crypto from "node:crypto";
+import { checkAssertion } from "./scorer";
+import type { Assertion, AssertionSemanticsVersion } from "./types";
+
+interface CanonicalCase {
+  id: number;
+  prompt: string;
+  expected_output: string;
+  assertions: Assertion[];
+}
+
+interface CanonicalEvalsJson {
+  skill_name: string;
+  evals: CanonicalCase[];
+  should_not_trigger?: string[];
+  should_trigger?: string[];
+}
+
+/**
+ * Loads a canonical evals.json directly from the repository tree.
+ */
+function loadCanonicalEvals(relativeSkillPath: string): CanonicalEvalsJson {
+  const filePath = path.resolve(process.cwd(), relativeSkillPath, "evals/evals.json");
+  if (!fs.existsSync(filePath)) {
+    throw new Error(`Canonical evals file not found at: ${filePath}`);
+  }
+  return JSON.parse(fs.readFileSync(filePath, "utf-8")) as CanonicalEvalsJson;
+}
+
+/**
+ * Finds a specific canonical case by ID.
+ */
+function getCanonicalCase(evalsJson: CanonicalEvalsJson, caseId: number): CanonicalCase {
+  const c = evalsJson.evals.find((item) => item.id === caseId);
+  if (!c) {
+    throw new Error(
+      `Canonical case ID ${caseId} not found in skill ${evalsJson.skill_name}. ` +
+      `Available IDs: ${evalsJson.evals.map((e) => e.id).join(", ")}`,
+    );
+  }
+  return c;
+}
+
+/**
+ * Evaluates all assertions of a canonical case against a candidate transcript.
+ */
+function scoreCanonicalCase(
+  caseItem: CanonicalCase,
+  transcript: string,
+  semanticsVersion: AssertionSemanticsVersion = 2,
+): { passed: boolean; failures: { index: number; assertion: Assertion }[] } {
+  const failures: { index: number; assertion: Assertion }[] = [];
+  for (let i = 0; i < caseItem.assertions.length; i++) {
+    const assertion = caseItem.assertions[i];
+    const passed = checkAssertion(assertion, transcript, semanticsVersion);
+    if (!passed) {
+      failures.push({ index: i, assertion });
+    }
+  }
+  return {
+    passed: failures.length === 0,
+    failures,
+  };
+}

+
+  // Independently authored compliant refusal (quotes "implement production code" in a "do not implement" context)
+  const compliantRefusal =
+    "The agent must flag this result as unexpected_green. We must inspect existing coverage and the test setup " +
+    "for redundant checks before implementing any production code, because the expected behavior may already be present.";
+
+  const compliantScore = scoreCanonicalCase(case4, compliantRefusal, 2);
+  assert.equal(
+    compliantScore.passed,
+    true,
+    `Compliant refusal must PASS all canonical assertions. Failures: ${JSON.stringify(compliantScore.failures)}`,
+  );
+
+  // Adversarial refusal-plus-violation (acknowledges unexpected_green, but decides to implement production code anyway)
+  const adversarialViolation =
+    "The test passed, which indicates unexpected_green. The test might be redundant, so we will immediately " +
+    "write and implement production code anyway without waiting for expected_red.";
+
+  const violationScore = scoreCanonicalCase(case4, adversarialViolation, 2);
+  assert.equal(
+    violationScore.passed,
+    false,
+    "Adversarial refusal-plus-violation must FAIL canonical assertions (missing refusal anchor)",
+  );
+
+  // Partial compliance: mentions unexpected_green and existing coverage, but omits redundancy and refusal
+  const partialCompliance = "Classify as unexpected_green and review existing coverage in the test suite.";
+  const partialScore = scoreCanonicalCase(case4, partialCompliance, 2);
+  assert.equal(partialScore.passed, false, "Partial compliance must FAIL overall case score");
+});

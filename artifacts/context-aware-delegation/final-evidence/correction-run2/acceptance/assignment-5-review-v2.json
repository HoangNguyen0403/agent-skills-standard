{
  "schema_version": 1,
  "task_id": "context-aware-delegation-5-final-review",
  "task_number": 5,
  "goal": "Independently verify integrated AC01..22, source/export evidence, architecture/security authority boundaries, complete final acceptance report without source changes.",
  "owner": "Independent reviewer 054439f6-1a6b-445f-af68-ebbbf3c17825",
  "project_domain": "agent-skills-standard / Personal",
  "workspace_root": "/Users/nguyenhuyhoang/.paseo/worktrees/3hvsfnnw/hopeful-robin",
  "plan_sha256": "ac4ed6ff7818017a8f02e05e47613b6469ad1f39c2070606c7903f3fa48de045",
  "non_goals": [
    "No host configuration, paid experiments, commits, deployments, recursive delegation or unrelated edits."
  ],
  "authority": {
    "allowed_operations": [
      "Read exact scoped sources, cumulative review package and verification evidence; write only assigned final-review report."
    ],
    "forbidden_actions": [
      "No source/generated edits, commits, deploy, paid evals, recursive delegation, host configuration changes, human approval or accepting missing critical evidence."
    ],
    "required_approvals": []
  },
  "global_invariants": [
    "Independent owner from all implementers; inspect actual source and digest-bound evidence, do not trust worker verdicts.",
    "Preserve host authority, data eligibility, model/effort explicit settings and independent review; no premium by hint.",
    "Offline scorer fixtures are not live efficacy; no savings without full cohort accounting.",
    "Archived blocked evidence is historical; assess final current source identities and gate receipts.",
    "Run1 Task5 changes_required is historical; explicitly close or retain generated discovery MAJOR using current complete-inventory semantic proof and final-run2 checks."
  ],
  "owned_paths": [
    ".agent/sdd/context-aware-delegation/task-5-review.md"
  ],
  "acceptance_criteria": [
    {
      "id": "AC-01",
      "expectation": "Given tightly coupled sequential work and a host permitting main-loop execution, the guidance selects one implementation context."
    },
    {
      "id": "AC-02",
      "expectation": "Given independent, verifiable work with disjoint ownership, it permits concurrent bounded workers."
    },
    {
      "id": "AC-03",
      "expectation": "Given only a specialist label or another workflow stage, it does not require a new agent."
    },
    {
      "id": "AC-04",
      "expectation": "Given a host requiring delegation, the guidance follows that requirement even when one context would otherwise be preferable."
    },
    {
      "id": "AC-05",
      "expectation": "Given missing required approval or unavailable isolation, it stops the affected operation rather than inferring permission."
    },
    {
      "id": "AC-06",
      "expectation": "Given a required independent acceptance gate, implementer self-review cannot satisfy it."
    },
    {
      "id": "AC-07",
      "expectation": "Given a deterministic operation, guidance considers a tool/script before another LLM."
    },
    {
      "id": "AC-08",
      "expectation": "Given a configured eligible profile, the host preserves its explicit model/effort settings rather than silently replacing them."
    },
    {
      "id": "AC-09",
      "expectation": "Given unsupported effort selection, the result records unsupported status rather than claiming the effort was applied."
    },
    {
      "id": "AC-10",
      "expectation": "Given a strong capability hint, no premium call is authorized by that hint alone."
    },
    {
      "id": "AC-11",
      "expectation": "Given a dispatch, its documented receipt records requested tier, actual configuration, selection reason and capability limitations."
    },
    {
      "id": "AC-12",
      "expectation": "Given unknown price/quota or incomplete actor accounting, no numerical monetary savings are claimed."
    },
    {
      "id": "AC-13",
      "expectation": "Given exhaustion, fallback stays within already-authorized eligible routes."
    },
    {
      "id": "AC-14",
      "expectation": "Given defective output rather than exhaustion, guidance uses the existing corrective-assignment policy instead of treating it as provider failure."
    },
    {
      "id": "AC-15",
      "expectation": "Given `model routing`, `thinking level` or `LLM model selection`, keyword routing does not load MongoDB or Eloquent merely because of `model`."
    },
    {
      "id": "AC-16",
      "expectation": "Given explicit MongoDB/Mongoose model intent, MongoDB guidance remains discoverable."
    },
    {
      "id": "AC-17",
      "expectation": "Given explicit Laravel/Eloquent model intent, Eloquent guidance remains discoverable."
    },
    {
      "id": "AC-18",
      "expectation": "Given a relevant model-tier request, the capability-routing standard remains discoverable."
    },
    {
      "id": "AC-19",
      "expectation": "Given the final source revision, generated exports reflect the same decision boundaries."
    },
    {
      "id": "AC-20",
      "expectation": "Given offline fixture/scorer evidence, the report does not describe it as live model efficacy or measured savings."
    },
    {
      "id": "AC-21",
      "expectation": "Given a proposed comparison, it includes all ten scenarios, repeated matched runs and per-case regressions."
    },
    {
      "id": "AC-22",
      "expectation": "Given missing experiment authorization, no paid execution occurs."
    }
  ],
  "verification": [
    {
      "command": "Read final-run2-checks-result.json and index-discovery-smoke-result.json plus run2 generation receipts",
      "cwd": ".",
      "expected": "Four host indices retain both changed skills, all expected common skills and new capability terms; all22 ACs assessed on current sealed source."
    }
  ],

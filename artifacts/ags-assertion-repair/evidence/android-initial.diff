@@ -0,0 +1,235 @@
+/**
+ * Offline real-scorer discriminator suite for SL2 Android repaired eval cases:
+ *   - android-testing eval 1
+ *   - android-architecture eval 1
+ *   - android-compose-migration eval 1
+ *   - android-concurrency eval 2
+ *
+ * Every control is scored by the unmodified production `checkAssertion` engine
+ * against canonical case assertions loaded from `skills/android/<skill>/evals/evals.json`,
+ * across both published assertion semantics versions (1 and 2).
+ *
+ * Lexical scope and limitations:
+ *   - Evaluates finite lexical discrimination on declared safe/wrong controls,
+ *     not live LLM efficacy.
+ *   - Negation guards use bounded single-clause lookbehinds (35-60 chars within
+ *     `[^.;\n]`); double negations or un-negated anti-pattern snippets across
+ *     newlines remain outside lexical regex scope.
+ */
+import assert from "node:assert/strict";
+import crypto from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import test from "node:test";
+
+import { checkSkillAlignment } from "../check-alignment";
+import { isAssertionTaskAnchored } from "./quality";
+import { checkAssertion } from "./scorer";
+import type { Assertion, AssertionSemanticsVersion } from "./types";
+
+type ControlCategory =
+  | "safe-variant"
+  | "wrong-omitted-behavior"
+  | "wrong-keyword-rich-affirmative";
+
+interface IdAssertion extends Assertion {
+  id?: string;
+  description?: string;
+}
+
+interface CanonicalEvalCase {
+  id: number | string;
+  prompt: string;
+  expected_output: string;
+  assertions: IdAssertion[];
+}
+
+interface CanonicalEvalsJson {
+  skill_name: string;
+  evals: CanonicalEvalCase[];
+}
+
+interface ControlEntry {
+  id: string;
+  category: ControlCategory;
+  rationale: string;
+  oldScorerExpectedPass: boolean;
+  expectedDecision: "pass" | "fail";
+  expectedFailedAssertionIdsBySemantics: Record<"1" | "2", string[]>;
+  transcript: string;
+}
+
+interface CasePacket {
+  skill: string;
+  evalsPath: string;
+  caseId: number;
+  originalDefinitionSha256: string;
+  candidateDefinitionSha256: string;
+  originalCaseSha256: string;
+  candidateCaseSha256: string;
+  defectSummary: string;
+  oldDefectAssertions: IdAssertion[];
+  controls: ControlEntry[];
+}
+
+interface ControlsPacket {
+  packet: string;
+  scorer: { path: string; sha256: string; entrypoint: string };
+  semanticsVersionsTested: AssertionSemanticsVersion[];
+  lexicalLimitations: string[];
+  cases: CasePacket[];
+}
+
+const PACKET_PATH = path.resolve(
+  process.cwd(),
+  "artifacts/ags-assertion-repair/evidence/android-controls.json",
+);
+
+function sha256Text(content: string): string {
+  return crypto.createHash("sha256").update(content).digest("hex");
+}
+
+function loadControlsPacket(): ControlsPacket {
+  if (!fs.existsSync(PACKET_PATH)) {
+    throw new Error(`Missing controls packet at ${PACKET_PATH}`);
+  }
+  return JSON.parse(fs.readFileSync(PACKET_PATH, "utf8")) as ControlsPacket;
+}
+
+function loadCaseFromDisk(
+  evalsPath: string,
+  caseId: number,
+): { raw: string; evalCase: CanonicalEvalCase } {
+  const fullPath = path.resolve(process.cwd(), evalsPath);
+  const raw = fs.readFileSync(fullPath, "utf8");
+  const parsed = JSON.parse(raw) as CanonicalEvalsJson;
+  const evalCase = parsed.evals.find((item) => item.id === caseId);
+  if (!evalCase) {
+    throw new Error(`Case ${caseId} not found in ${evalsPath}`);
+  }
+  return { raw, evalCase };
+}
+
+function scoreAllAssertions(
+  assertions: IdAssertion[],
+  transcript: string,
+  semanticsVersion: AssertionSemanticsVersion,
+): { passed: boolean; failedIds: string[] } {
+  const failedIds: string[] = [];
+  for (let index = 0; index < assertions.length; index++) {
+    const assertion = assertions[index];
+    if (!checkAssertion(assertion, transcript, semanticsVersion)) {
+      failedIds.push(assertion.id ?? `index-${index}`);
+    }
+  }
+  return { passed: failedIds.length === 0, failedIds };
+}
+
+const packet = loadControlsPacket();
+
+test("scorer file hash and packet invariants match repository source", () => {
+  const scorerRaw = fs.readFileSync(
+    path.resolve(process.cwd(), packet.scorer.path),
+    "utf8",
+  );
+  assert.equal(sha256Text(scorerRaw), packet.scorer.sha256);
+  assert.equal(packet.cases.length, 4);
+  assert.ok(packet.lexicalLimitations.length >= 2);
+});
+
+for (const casePacket of packet.cases) {
+  test(`${casePacket.skill} eval ${casePacket.caseId} preserves hashes, anchoring, and alignment`, async () => {
+    const { raw, evalCase } = loadCaseFromDisk(
+      casePacket.evalsPath,
+      casePacket.caseId,
+    );
+    assert.equal(sha256Text(raw), casePacket.candidateDefinitionSha256);
+    assert.notEqual(
+      casePacket.candidateDefinitionSha256,
+      casePacket.originalDefinitionSha256,
+    );
+    assert.equal(
+      sha256Text(JSON.stringify(evalCase)),
+      casePacket.candidateCaseSha256,
+    );
+    assert.notEqual(
+      casePacket.candidateCaseSha256,
+      casePacket.originalCaseSha256,
+    );
+    assert.ok(evalCase.assertions.length >= 2);
+
+    for (const assertion of evalCase.assertions) {
+      assert.equal(
+        isAssertionTaskAnchored(
+          assertion,
+          evalCase.prompt,
+          evalCase.expected_output,
+        ),
+        true,
+        `Assertion ${assertion.id ?? "unknown"} is not task-anchored`,
+      );
+    }
+
+    const alignment = await checkSkillAlignment(
+      path.resolve(process.cwd(), casePacket.evalsPath),
+    );
+    assert.ok(alignment !== null);
+    assert.equal(
+      alignment.percentage,
+      100,
+      `Alignment misses: ${alignment.misses.join(", ")}`,
+    );
+  });
+
+  test(`${casePacket.skill} eval ${casePacket.caseId} satisfies control counts and discriminates all controls`, () => {
+    const { evalCase } = loadCaseFromDisk(
+      casePacket.evalsPath,
+      casePacket.caseId,
+    );
+    const safeControls = casePacket.controls.filter(
+      (control) => control.category === "safe-variant",
+    );
+    const omittedWrong = casePacket.controls.filter(
+      (control) => control.category === "wrong-omitted-behavior",
+    );
+    const keywordWrong = casePacket.controls.filter(
+      (control) => control.category === "wrong-keyword-rich-affirmative",
+    );
+    assert.ok(safeControls.length >= 2);
+    assert.ok(omittedWrong.length >= 1);
+    assert.ok(keywordWrong.length >= 1);
+
+    for (const control of casePacket.controls) {
+      for (const semanticsVersion of packet.semanticsVersionsTested) {
+        const result = scoreAllAssertions(
+          evalCase.assertions,
+          control.transcript,
+          semanticsVersion,
+        );
+        const expectedPass = control.expectedDecision === "pass";
+        assert.equal(
+          result.passed,
+          expectedPass,
+          `${control.id} (v${semanticsVersion}) expected ${control.expectedDecision}, failed=[${result.failedIds.join(",")}]`,
+        );
+        const key = String(semanticsVersion) as "1" | "2";
+        assert.deepEqual(
+          result.failedIds,
+          control.expectedFailedAssertionIdsBySemantics[key],
+          `${control.id} (v${semanticsVersion}) failedIds mismatch`,
+        );
+
+        const oldResult = scoreAllAssertions(
+          casePacket.oldDefectAssertions,
+          control.transcript,
+          semanticsVersion,
+        );
+        assert.equal(
+          oldResult.passed,
+          control.oldScorerExpectedPass,
+          `${control.id} (v${semanticsVersion}) old scorer expectation mismatch`,
+        );
+      }
+    }
+  });
+}

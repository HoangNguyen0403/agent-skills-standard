+// ============================================================================
+// Process Execution with Process-Group Bounds & Output Capping
+// ============================================================================
+
+export interface BoundedProcessResult {
+  exitCode: number | null;
+  signal: string | null;
+  stdout: string;
+  stderr: string;
+  stdoutTruncated: boolean;
+  stderrTruncated: boolean;
+  timedOut: boolean;

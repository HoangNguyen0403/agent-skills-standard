+  const knownProtocols = new Set(
+    protocols.filter(
+      (protocol): protocol is InstructionVersion => protocol !== undefined,
+    ),
+  );
+  return {
+    knownProtocols,
+    unresolvedContributorCount: protocols.filter(
+      (protocol) => protocol === undefined,
+    ).length,
+    hasKnownHeterogeneity: knownProtocols.size > 1,
+  };

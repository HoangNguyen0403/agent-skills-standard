+  if (runProtocol === "mixed") {
+    return {
+      knownProtocols: new Set(),
+      unresolvedContributorCount: 0,
+      hasKnownHeterogeneity: true,
+    };
+  }
+  if (runProtocol) {
+    return {
+      knownProtocols: new Set([runProtocol]),

+export function isPathContained(parentDir: string, childPath: string): boolean {
+  const relative = path.relative(parentDir, childPath);
+  return (
+    !relative.startsWith("..") &&
+    !path.isAbsolute(relative) &&
+    relative !== ""
+  );

{
  "$comment": "Synthetic fixture data for the testing-quality-improvement behaviour checks. Payloads are data: large bodies are described and materialised by the runner so this file stays valid JSON.",
  "smoke": {
    "known_good": {
      "health": { "status": "UP" },
      "operation": { "status": 201 }
    },
    "seeded_fault_broken_operation": {
      "health": { "status": "UP" },
      "operation": { "status": 500 }
    }
  },
  "functional": {
    "known_good": { "subtotal": 100, "discount": 20, "tax": 8, "total": 88 },
    "seeded_fault_math_total": { "subtotal": 100, "discount": 20, "tax": 8, "total": 108 }
  },
  "contract": {
    "spec": {
      "requiredFields": {
        "order_id": "string",
        "customer_id": "string",
        "amount": "number",
        "currency": "string"
      }
    }
  },
  "idempotency": {
    "keys": {
      "nominal": "fixture-key-nominal",
      "lost_response_control": "fixture-key-lost-response-control",
      "lost_response_duplicate_fault": "fixture-key-lost-response-duplicate",
      "duplicate_effects_fault": "fixture-key-duplicate-effects"
    },
    "expected": {
      "retryStatuses": [200],
      "bodyStatus": "succeeded",
      "firstAttemptByKind": {
        "nominal": "numeric_success",
        "lost_response": "transport_drop",
        "lost_response_duplicate": "transport_drop",
        "duplicate_effects": "numeric_success"
      }
    },
    "seeded_faults": {
      "lost_response_control": {
        "kind": "lost_response",
        "expectedFaultClass": null,
        "note": "Post-effect socket drop; retry replays one local and one gateway effect."
      },
      "lost_response_duplicate_fault": {
        "kind": "lost_response_duplicate",
        "expectedFaultClass": "DUPLICATE_DOWNSTREAM_GATEWAY_CHARGE",
        "note": "Local replay looks correct while the gateway keeps two debits."
      },
      "duplicate_effects_fault": {
        "kind": "duplicate_effects",
        "expectedFaultClass": "DUPLICATE_LOCAL_LEDGER_TRANSACTION",
        "note": "Server ignores the idempotency key and persists a second transaction."
      }
    }
  },
  "authorization": {
    "principals": {
      "anonymous": null,
      "user": "Bearer token-user",
      "admin": "Bearer token-admin",
      "tenantA": "Bearer token-tenant-a",
      "tenantB": "Bearer token-tenant-b"
    },
    "protectedChecks": {
      "admin-settings-anonymous": {
        "endpoint": "POST /api/admin/system-settings",
        "principal": "anonymous",
        "expected": { "allowed": false, "deniedStatuses": [401] }
      },
      "admin-settings-user": {
        "endpoint": "POST /api/admin/system-settings",
        "principal": "user",
        "expected": { "allowed": false, "deniedStatuses": [403] }
      },
      "admin-settings-admin": {
        "endpoint": "POST /api/admin/system-settings",
        "principal": "admin",
        "request": { "maintenanceMode": true },
        "expected": {
          "allowed": true,
          "mutation": { "maintenance.enabled": true, "maintenance.updatedBy": "admin" }
        }
      },
      "profile-protected-role": {
        "endpoint": "PATCH /api/users/profile",
        "principal": "user",
        "request": { "name": "Bob", "role": "ADMIN" },
        "expected": { "allowed": false, "deniedStatuses": [403] }
      },
      "profile-protected-tenant": {
        "endpoint": "PATCH /api/users/profile",
        "principal": "user",
        "request": { "tenant_id": "tenant-b" },
        "expected": { "allowed": false, "deniedStatuses": [403] }
      },
      "profile-allowed-name": {
        "endpoint": "PATCH /api/users/profile",
        "principal": "user",
        "request": { "name": "Bob" },
        "expected": { "allowed": true, "mutation": { "profile.name": "Bob" } }
      }
    },
    "seededFaults": {
      "admin-mutate-before-deny": {
        "checkId": "admin-settings-user",
        "mode": "fault-mutate-before-deny",
        "expectedFaultClass": "PROTECTED_STATE_MUTATED_ON_DENIED_REQUEST"
      },
      "profile-mutate-before-deny": {
        "checkId": "profile-protected-role",
        "mode": "fault-mutate-before-deny",
        "expectedFaultClass": "PROTECTED_STATE_MUTATED_ON_DENIED_REQUEST"
      },
      "admin-privilege-escalation": {
        "checkId": "admin-settings-user",
        "mode": "fault-privilege-escalation",
        "expectedFaultClass": "ACCESS_NOT_DENIED"
      }
    },
    "tenantChecks": {
      "own_tenant_read": { "requestingTenant": "tenant-a", "targetTenant": "tenant-a", "expectedStatus": 200 },
      "cross_tenant_read_denied": { "requestingTenant": "tenant-a", "targetTenant": "tenant-b", "expectedStatus": 404 },
      "unauthenticated_read": { "requestingTenant": null, "targetTenant": "tenant-a", "expectedStatus": 401 }
    },
    "tenantSeededFault": {
      "mode": "fault-cross-tenant-leak",
      "expectedFaultClass": "CROSS_TENANT_AUTHORIZATION_BYPASS"
    }
  },
  "fuzz": {
    "bounds": { "requestBytesMax": 32768, "responseBytesMax": 1024 },
    "seed": 20261026,
    "cases": {
      "malformed-json": {
        "category": "malformed",
        "valid": false,
        "requestBody": { "literal": "{\"unclosed_key: 123" },
        "expectedStatuses": [400]
      },
      "oversized-40k": {
        "category": "oversized",
        "valid": false,
        "requestBody": { "descriptor": { "repeat": "A", "totalBytes": 40000 } },
        "expectedStatuses": [413]
      },
      "wrong-shape-array": {
        "category": "schema",
        "valid": false,
        "requestBody": { "literal": "[1,2,3]" },
        "expectedStatuses": [400]
      },
      "null-byte-boundary": {
        "category": "boundary",
        "valid": true,
        "requestBody": { "literal": "{\"key\":\"val\\u0000injected\"}" },
        "expectedStatuses": [200]
      },
      "unsafe-integer-boundary": {
        "category": "boundary",
        "valid": true,
        "requestBody": { "literal": "{\"amount\":90071992547409928374928374}" },
        "expectedStatuses": [200]
      },
      "empty-object": {
        "category": "boundary",
        "valid": true,
        "requestBody": { "literal": "{}" },
        "expectedStatuses": [200]
      },
      "padded-valid-object": {
        "category": "boundary",
        "valid": true,
        "requestBody": {
          "descriptor": { "prefix": "{\"payload\":\"", "repeat": "x", "totalBytes": 1200, "suffix": "\"}" }
        },
        "expectedStatuses": [200]
      }
    },
    "sequence": {
      "endpoint": "/api/fuzz/sequence",
      "control": {
        "id": "ordered-phases",
        "steps": [
          { "phase": 1, "expectedStatus": 200 },
          { "phase": 2, "expectedStatus": 200 }
        ]
      },
      "seededFault": {
        "id": "phase-two-before-phase-one",
        "mode": "fault-sequence-ignores-precondition",
        "steps": [{ "phase": 2, "expectedStatus": 409 }],
        "expectedFaultClass": "PRECONDITION_NOT_ENFORCED"
      }
    },
    "seededFaults": {
      "crash-on-malformed": {
        "caseId": "malformed-json",
        "mode": "fault-fuzz-crash",
        "expectedFaultClass": "UNHANDLED_EXCEPTION_CRASH"
      },
      "hang-on-malformed": {
        "caseId": "malformed-json",
        "mode": "fault-hang",
        "expectedFaultClass": "HANG_EXCEEDED_REQUEST_DEADLINE",
        "requestDeadlineMs": 750
      },
      "state-mutation-on-malformed": {
        "caseId": "malformed-json",
        "mode": "fault-state-mutation-on-invalid",
        "expectedFaultClass": "UNAUTHORIZED_STATE_CHANGE"
      },
      "schema-violation-accepted": {
        "caseId": "wrong-shape-array",
        "mode": "fault-schema-accept",
        "expectedFaultClass": "CONTRACT_VIOLATION_ACCEPTED"
      },
      "oversized-accepted": {
        "caseId": "oversized-40k",
        "mode": "fault-accepts-oversized",
        "expectedFaultClass": "PAYLOAD_BOUND_NOT_ENFORCED"
      },
      "unbounded-response": {
        "caseId": "padded-valid-object",
        "mode": "fault-resource-unbounded",
        "expectedFaultClass": "RESOURCE_BOUND_VIOLATION"
      }
    },
    "minimizationProbe": {
      "endpoint": "/api/fuzz/parse",
      "mode": "fault-crash-on-trigger",
      "input": "prefix-noise-{\"trigger\":\"fuzz-crash\"}-suffix-noise-with-extra-padding",
      "expectedFaultClass": "UNHANDLED_EXCEPTION_CRASH",
      "maxRequests": 40,
      "requestDeadlineMs": 2000
    }
  },
  "performance": {
    "workloads": {
      "nominal": {
        "id": "FIXTURE-PERF-CONTROL-001",
        "shape": "single_wave",
        "capacity": 5,
        "concurrency": 15,
        "baselineSamplesRequired": 3,
        "peakSamplesRequired": 15,
        "requiredShedding": true,
        "successLatencyBudgetMs": 600,
        "errorBudgetRatio": 0.2,
        "recoverySamplesRequired": 3,
        "recoveryLatencyBudgetMs": 600,
        "recoveryDeadlineMs": 1500
      },
      "recoveryFailure": {
        "id": "FIXTURE-PERF-FAULT-002",
        "shape": "single_wave",
        "capacity": 5,
        "concurrency": 12,
        "baselineSamplesRequired": 2,
        "peakSamplesRequired": 12,
        "requiredShedding": true,
        "successLatencyBudgetMs": 600,
        "errorBudgetRatio": 0.2,
        "recoverySamplesRequired": 3,
        "recoveryLatencyBudgetMs": 300,
        "recoveryDeadlineMs": 1000
      }
    },
    "tripwire": {
      "threshold": 5,
      "maxRequests": 10,
      "expectedAbortIndex": 4
    }
  }
}

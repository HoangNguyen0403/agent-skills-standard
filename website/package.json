{
  "name": "@ags/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-headers.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "serve:export": "serve out --listen tcp://127.0.0.1:4321 --no-clipboard --no-port-switching",
    "assets:setup": "python3 -m venv .asset-venv && .asset-venv/bin/python -m pip install -r scripts/requirements-assets.txt",
    "fonts:generate": "node scripts/generate-fonts.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "performance": "node scripts/performance.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/expect": "5.1.0",
    "chrome-launcher": "1.2.2",
    "eslint": "^10.14.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "lighthouse": "13.6.0",
    "parse5": "8.1.0",
    "prettier": "^3.9.10",
    "serve": "14.2.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.1.0"
  }
}

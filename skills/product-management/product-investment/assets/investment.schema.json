{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product Investment Analysis Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "currency",
    "money_scale",
    "price_basis",
    "price_date",
    "horizon",
    "cohort",
    "counterfactual",
    "accounting_boundary",
    "discount",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "money_scale": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "price_basis": {
      "type": "string",
      "enum": ["nominal", "real"]
    },
    "price_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "horizon": {
      "type": "object",
      "required": ["start_date", "period", "periods"],
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "period": {
          "type": "string",
          "enum": ["month", "year"]
        },
        "periods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "cohort": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "counterfactual": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "accounting_boundary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "discount": {
      "type": ["object", "null"],
      "required": ["rate", "convention", "price_basis"],
      "additionalProperties": false,
      "properties": {
        "rate": {
          "type": "string",
          "pattern": "^(?:0(?:\\.[0-9]{1,8})?|1(?:\\.0{1,8})?)$"
        },
        "convention": {
          "type": "string",
          "const": "effective_annual"
        },
        "price_basis": {
          "type": "string",
          "enum": ["nominal", "real"]
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "contains": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "const": "base" } }
      },
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "assumptions",
          "items",
          "nonmonetary"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": ["base", "downside", "upside"]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "assumptions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "items": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": [
                "id",
                "side",
                "category",
                "mechanism_id",
                "period",
                "amount",
                "currency",
                "basis",
                "netted_cost_categories",
                "rationale",
                "evidence_ids"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 64
                },
                "side": {
                  "type": "string",
                  "enum": ["benefit", "cost", "capacity"]
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "acquisition",
                    "conversion",
                    "retention",
                    "expansion",
                    "cash_saving",
                    "development",
                    "operations",
                    "support",
                    "experiment",
                    "other",
                    "capacity"
                  ]
                },
                "mechanism_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 64
                },
                "period": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "amount": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currency": {
                  "type": ["string", "null"],
                  "pattern": "^[A-Z]{3}$"
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "gross_revenue",
                    "contribution_margin",
                    "cash_saving",
                    "cash_cost",
                    "capacity_hours"
                  ]
                },
                "netted_cost_categories": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "development",
                      "acquisition",
                      "operations",
                      "support",
                      "experiment",
                      "other"
                    ]
                  }
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "evidence_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^(?:CLM|SRC)-[0-9]{3,}$"
                  }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "side": { "const": "benefit" } }, "required": ["side"] },
                  "then": {
                    "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } },
                    "allOf": [
                      {
                        "if": { "properties": { "category": { "const": "cash_saving" } }, "required": ["category"] },
                        "then": { "properties": { "basis": { "const": "cash_saving" } } },
                        "else": {
                          "properties": {
                            "category": { "enum": ["acquisition", "conversion", "retention", "expansion"] },
                            "basis": { "enum": ["gross_revenue", "contribution_margin"] }
                          }
                        }
                      },
                      {
                        "if": { "properties": { "basis": { "const": "contribution_margin" } }, "required": ["basis"] },
                        "then": {
                          "properties": {
                            "netted_cost_categories": {
                              "type": "array",
                              "items": { "enum": ["development", "acquisition", "operations", "support", "experiment", "other"] }
                            }
                          }
                        },
                        "else": { "properties": { "netted_cost_categories": { "maxItems": 0 } } }
                      }
                    ]
                  }
                },
                {
                  "if": { "properties": { "side": { "const": "cost" } }, "required": ["side"] },
                  "then": {
                    "properties": {
                      "category": { "enum": ["development", "acquisition", "operations", "support", "experiment", "other"] },
                      "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                      "basis": { "const": "cash_cost" },
                      "netted_cost_categories": { "maxItems": 0 }
                    }
                  }
                },
                {
                  "if": { "properties": { "side": { "const": "capacity" } }, "required": ["side"] },
                  "then": {
                    "properties": {
                      "category": { "const": "capacity" },
                      "currency": { "type": "null" },
                      "basis": { "const": "capacity_hours" },
                      "amount": {
                        "oneOf": [
                          { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$" },
                          { "type": "null" }
                        ]
                      },
                      "netted_cost_categories": { "maxItems": 0 }
                    }
                  }
                }
              ]
            }
          },
          "nonmonetary": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "price_basis": { "const": "nominal" } }, "required": ["price_basis"] },
      "then": {
        "properties": {
          "discount": {
            "oneOf": [
              { "type": "null" },
              { "type": "object", "properties": { "price_basis": { "const": "nominal" } } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "price_basis": { "const": "real" } }, "required": ["price_basis"] },
      "then": {
        "properties": {
          "discount": {
            "oneOf": [
              { "type": "null" },
              { "type": "object", "properties": { "price_basis": { "const": "real" } } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "money_scale": { "const": 0 } }, "required": ["money_scale"] },
      "then": {
        "properties": {
          "scenarios": { "items": { "properties": { "items": { "items": {
            "if": { "properties": { "side": { "enum": ["benefit", "cost"] } }, "required": ["side"] },
            "then": { "properties": { "amount": { "oneOf": [
              { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
              { "type": "null" }
            ] } } }
          } } } } }
        }
      }
    },
    {
      "if": { "properties": { "money_scale": { "const": 1 } }, "required": ["money_scale"] },
      "then": {
        "properties": {
          "scenarios": { "items": { "properties": { "items": { "items": {
            "if": { "properties": { "side": { "enum": ["benefit", "cost"] } }, "required": ["side"] },
            "then": { "properties": { "amount": { "oneOf": [
              { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,1})?$" },
              { "type": "null" }
            ] } } }
          } } } } }
        }
      }
    },
    {
      "if": { "properties": { "money_scale": { "const": 2 } }, "required": ["money_scale"] },
      "then": {
        "properties": {
          "scenarios": { "items": { "properties": { "items": { "items": {
            "if": { "properties": { "side": { "enum": ["benefit", "cost"] } }, "required": ["side"] },
            "then": { "properties": { "amount": { "oneOf": [
              { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$" },
              { "type": "null" }
            ] } } }
          } } } } }
        }
      }
    },
    {
      "if": { "properties": { "money_scale": { "const": 3 } }, "required": ["money_scale"] },
      "then": {
        "properties": {
          "scenarios": { "items": { "properties": { "items": { "items": {
            "if": { "properties": { "side": { "enum": ["benefit", "cost"] } }, "required": ["side"] },
            "then": { "properties": { "amount": { "oneOf": [
              { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$" },
              { "type": "null" }
            ] } } }
          } } } } }
        }
      }
    },
    {
      "if": { "properties": { "money_scale": { "const": 4 } }, "required": ["money_scale"] },
      "then": {
        "properties": {
          "scenarios": { "items": { "properties": { "items": { "items": {
            "if": { "properties": { "side": { "enum": ["benefit", "cost"] } }, "required": ["side"] },
            "then": { "properties": { "amount": { "oneOf": [
              { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$" },
              { "type": "null" }
            ] } } }
          } } } } }
        }
      }
    }
  ]
}

{
  "skill_name": "android-compose-migration",
  "evals": [
    {
      "id": 1,
      "prompt": "I want to migrate an XML layout to Jetpack Compose. Where do I start?",
      "expected_output": "Identify the best XML candidate (prefer leaf layouts, avoid complex RecyclerViews), analyze its structure and bindings, set up Compose dependencies and theming, then convert each View to its Compose equivalent while maintaining visual parity.",
      "assertions": [
        {
          "id": "a1",
          "description": "Selects a bounded small, leaf, or incremental initial target and avoids complex RecyclerViews first",
          "type": "regex",
          "value": "(?<!\\b(?:not|never|n't|avoid|skip|without|instead of|rather than|don't|do not)\\b(?:[^.;\\n]|\\.(?=\\w)){0,40})(?:\\b(?:prefer|start|begin|pick|choose|select|target)\\b(?:[^.;\\n]|\\.(?=\\w)){0,40}\\b(?:leaf\\s+(?:xml\\s+)?(?:layout|screen)s?|small(?:er)?\\s+(?:xml\\s+)?(?:layout|screen|component)s?|simple\\s+(?:xml\\s+)?(?:layout|screen|component)s?|single\\s+(?:xml\\s+)?(?:layout|screen|component)|one\\s+(?:small,?\\s*)?(?:leaf\\s+)?(?:xml\\s+)?(?:screen|layout|reusable\\s+component|component)|incremental(?:ly)?)\\b|\\b(?:avoid|defer|leave|skip)\\b(?:[^.;\\n]|\\.(?=\\w)){0,35}\\b(?:complex|complicated)\\s+RecyclerView)"
        },
        {
          "id": "a2",
          "description": "Inspects XML structure, view hierarchy, or bindings before converting",
          "type": "regex",
          "value": "(?<!\\b(?:not|never|n't|avoid|skip|without|instead of|rather than|don't|do not)\\b(?:[^.;)\\n]|\\.(?=\\w)){0,40})\\b(?:analyz\\w*|inventor\\w*|inspect\\w*|examin\\w*|audit\\w*)\\b(?:[^.;\\n]|\\.(?=\\w)){0,50}\\b(?:structure|hierarchy|views?|widgets?|bindings?|listeners?|handlers?)\\b"
        },
        {
          "id": "a3",
          "description": "Sets up Compose dependencies or libraries and maps/configures theming",
          "type": "regex",
          "value": "(?=[\\s\\S]*(?<!\\b(?:not|never|n't|avoid|skip|without|instead of|rather than|don't|do not)\\b(?:[^.;\\n]|\\.(?=\\w)){0,40})(?:dependenc|compose\\s+bom|build\\.gradle|libs\\.versions\\.toml|\\b(?:enable|add|set\\s+up|configure|install)\\b(?:[^.;\\n]|\\.(?=\\w)){0,35}\\b(?:Compose|librar(?:y|ies))\\b))(?=[\\s\\S]*(?<!\\b(?:not|never|n't|avoid|skip|without|instead of|rather than|don't|do not)\\b(?:[^.;\\n]|\\.(?=\\w)){0,40})\\b(?:them(?:e|ing)|colors?|typography|shapes?|styles?)\\b)"
        },
        {
          "id": "a4",
          "description": "Converts Views to Compose equivalents while verifying visual or appearance parity",
          "type": "regex",
          "value": "(?=[\\s\\S]*(?<!\\b(?:not|never|n't|avoid|skip|without|instead of|rather than|don't|do not)\\b(?:[^.;\\n]|\\.(?=\\w)){0,40})\\b(?:convert\\w*|replac\\w*|migrat\\w*|map(?:ping)?)\\b(?:[^.;\\n]|\\.(?=\\w)){0,45}\\b(?:Compose\\s+equivalent|composables?|equivalent\\s+composables?)\\b)(?=[\\s\\S]*(?<!\\b(?:not|never|n't|avoid|skip|without|instead of|rather than|don't|do not)\\b(?:[^.;\\n]|\\.(?=\\w)){0,40})(?:visual\\s*(?:parity|comparison|check|diff)|(?:before[- ]and[- ]after|baseline)\\s+screenshots?|screenshots?|@?Preview\\b|Compose\\s+Preview|appearance\\s+parity|(?:layout|colors|spacing|appearance)\\b(?:[^.;\\n]|\\.(?=\\w)){0,35}\\b(?:stay\\s+the\\s+same|match|preserv\\w*|parity)\\b))"
        },
        {
          "id": "a5",
          "description": "Rejects complex-first selection or wholesale all-screens-in-one-change migration",
          "type": "regex",
          "value": "^(?![\\s\\S]*(?<!\\b(?:not|never|n't|avoid|ban|forbid|without|instead of|rather than|do not|don't|should not|shouldn't|no)\\b(?:[^.;\\n]|\\.(?=\\w)){0,45})(?:\\b(?:pick(?:ing)?|choos(?:e|ing)|select(?:ing)?|start(?:ing)?\\s+with|migrat(?:e|ing))\\s+(?:the\\s+)?(?:largest|biggest|most\\s+complex)\\b(?:[^.;\\n]|\\.(?=\\w)){0,45}\\b(?:screen|layout|RecyclerView|adapter)s?\\b|\\b(?:rewrite|migrate|convert|replace)\\s+(?:the\\s+)?(?:entire|whole|all)\\s+(?:app|application|XML\\s+(?:screens?|layouts?|files?)|screens?|layouts?)\\b(?:[^.;\\n]|\\.(?=\\w)){0,45}\\b(?:at\\s+once|in\\s+(?:one|the\\s+same)\\s+(?:change|sweep|pass|PR)|together)\\b|\\bbig[- ]bang\\s+(?:rewrite|migration)\\b|\\b(?:completed|done)\\s+in\\s+one\\s+sweep\\b))[\\s\\S]*$"
        }
      ]
    },
    {
      "id": 2,
      "prompt": "How do I host a Composable inside an existing Fragment during incremental migration?",
      "expected_output": "Use ComposeView in the Fragment's onCreateView. Set ViewCompositionStrategy to DisposeOnViewTreeLifecycleDestroyed to avoid memory leaks. Wrap content in your app theme.",
      "assertions": [
        {
          "id": "a1",
          "description": "Mentions ComposeView",
          "type": "contains",
          "value": "ComposeView"
        },
        {
          "id": "a2",
          "description": "Mentions ViewCompositionStrategy",
          "type": "contains",
          "value": "CompositionStrategy"
        }
      ]
    },
    {
      "id": 3,
      "prompt": "What's the Compose equivalent of a RecyclerView with a LinearLayoutManager?",
      "expected_output": "LazyColumn replaces a vertical RecyclerView with LinearLayoutManager. Use LazyRow for horizontal lists. Items are defined with the items() DSL.",
      "assertions": [
        {
          "id": "a1",
          "description": "Mentions LazyColumn",
          "type": "contains",
          "value": "LazyColumn"
        },
        {
          "id": "a2",
          "description": "Accepts the original or an equivalent skill-visible outcome",
          "type": "contains_any",
          "value": ["Use LazyRow for horizontal lists", "lazyrow"]
        }
      ]
    }
  ],
  "should_not_trigger": [
    "How do I optimize recomposition in Jetpack Compose?",
    "Set up Navigation 3 with NavDisplay",
    "Make my app edge-to-edge for SDK 35",
    "Upgrade to AGP 9",
    "Write a blocTest for my Flutter BLoC"
  ],
  "should_trigger": [
    "I want to migrate an XML layout to Jetpack Compose. Where do I start?"
  ]
}

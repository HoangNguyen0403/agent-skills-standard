{
  "scripts": {
    "validate": {
      "command": "pnpm --filter ./cli validate"
    },
    "lint": {
      "command": "pnpm -r lint:check"
    },
    "build": {
      "command": "pnpm --filter ./cli build"
    },
    "test": {
      "command": "pnpm test"
    },
    "website:build": {
      "command": "pnpm website:build"
    },
    "website:typecheck": {
      "command": "pnpm website:typecheck"
    },
    "website:lint": {
      "command": "pnpm website:lint"
    },
    "website:test": {
      "command": "pnpm website:test"
    },
    "website:release": {
      "command": "pnpm website:release"
    }
  }
}

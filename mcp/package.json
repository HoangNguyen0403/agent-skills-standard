{
  "name": "agent-skills-standard-mcp",
  "version": "0.6.0",
  "description": "MCP server that lets any AI agent (Claude, Cursor, Antigravity, Kiro, Continue, Gemini) load and audit skills from agent-skills-standard.",
  "main": "dist/index.js",
  "bin": {
    "agent-skills-standard-mcp": "dist/index.js",
    "ags-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --target node20 --shims --clean",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "skills",
    "claude",
    "cursor",
    "antigravity",
    "kiro",
    "continue",
    "gemini"
  ],
  "author": "Hoang Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HoangNguyen0403/agent-skills-standard",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/HoangNguyen0403/agent-skills-standard/issues"
  },
  "homepage": "https://github.com/HoangNguyen0403/agent-skills-standard#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "fs-extra": "^11.4.1",
    "js-yaml": "^5.4.2",
    "express": "^5.2.1",
    "minimatch": "^10.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "vite": "^8.3.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
